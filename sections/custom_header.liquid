{% liquid
  assign search_style = 'none'
  if section.settings.show_search
    render 'predictive-search-styles'
    render 'slideshow-styles'
    assign search_style = 'modal'
  endif

  assign sticky = false
  if section.settings.enable_sticky_header == 'always'
    assign sticky = 'always'
  elsif section.settings.enable_sticky_header == 'scroll-up'
    assign sticky = 'scroll-up'
  endif

  assign show_language = section.settings.show_language
  unless request.design_mode
    if localization.available_languages.size <= 1
      assign show_language = false
    endif
  endunless

  assign show_country = section.settings.show_country
  unless request.design_mode
    if localization.available_countries.size <= 1
      assign show_country = false
    endif
  endunless

  if request.design_mode
    if section.settings.show_country
      assign show_country = true
    endif
    if section.settings.show_language
      assign show_language = true
    endif
  endif

  assign show_localization = false
  if show_language or show_country
    assign show_localization = true
  endif

  assign logo_display = section.settings.logo_display | default: 'auto'
  assign is_transparent_home = false
  if section.settings.enable_transparent_home and request.page_type == 'index'
    assign is_transparent_home = true
  endif

  assign sidebar_menu = section.settings.menu
  assign shop_trigger_label = section.settings.shop_all_label
  if shop_trigger_label == blank and sidebar_menu != blank
    assign shop_trigger_label = sidebar_menu.title
  endif
  if shop_trigger_label == blank
    assign shop_trigger_label = 'Shop All'
  endif
%}

{%- comment -%} ── Structured Data ── {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- comment -%} ── Header Component ── {%- endcomment -%}
<header-component
  id="header-component"
  class="uly-header color-{{ section.settings.color_scheme }}{% if is_transparent_home %} uly-header--transparent{% endif %}{% if section.settings.sticky_style == 'glassmorphism' %} uly-header--glass{% endif %}"
  data-theme-color="rgb({{ section.settings.color_scheme.settings.background.rgb }})"
  data-sticky-style="{{ section.settings.sticky_style | default: 'glassmorphism' }}"
  {% if sticky %}sticky="{{ sticky }}"{% endif %}
  data-scroll-direction="none"
  data-skip-node-update
  style="
    --logo-max-width: {{ section.settings.logo_max_width | default: 160 }}px;
    --menu-image-border-radius: {{ section.settings.image_border_radius | default: 4 }}px;
    --uly-header-background-color: {{ section.settings.header_background_color | default: '#FFE8DD' }};
    --uly-search-trigger-background-color: {{ section.settings.search_trigger_background_color | default: '#FFFFFF' }};
  "
>
  {%- if request.page_type == 'index' -%}
    <h1 class="visually-hidden">{{ shop.name }}</h1>
  {%- endif -%}

  <div class="uly-header__underlay uly-header__underlay--closed"></div>
  <div class="uly-header__underlay uly-header__underlay--open"></div>

  <div class="uly-header__shell">

    {%- comment -%} ── TOP ROW: Logo | Search + Social + Localization + Actions ── {%- endcomment -%}
    <div class="uly-header__row color-{{ section.settings.color_scheme }} section section--full-width-margin" ref="headerRowTop">
      <div class="uly-header__inner spacing-style">

        {%- comment -%} LEFT: Shop All trigger + Logo {%- endcomment -%}
        <div class="uly-header__col uly-header__col--left">
          <button
            type="button"
            id="uly-shop-drawer-trigger"
            class="uly-shop-bar__trigger uly-shop-bar__trigger--header"
            aria-expanded="false"
            aria-controls="uly-shop-sidebar"
          >
            <span class="uly-shop-bar__label">{{ shop_trigger_label | escape }}</span>
            {% comment %} <span class="uly-shop-bar__arrow" style="font-size: 18px !important;" aria-hidden="true">&rsaquo;</span> {% endcomment %}
            {%- if section.settings.shop_all_suffix != blank -%}
              <span class="uly-shop-bar__suffix">{{ section.settings.shop_all_suffix | escape }}</span>
            {%- endif -%}
          </button>

          {%- liquid
            assign logo_img = section.settings.logo_image | default: settings.logo
            assign show_logo_image = false
            assign show_shop_name = false

            if logo_img != blank and logo_display != 'text'
              assign show_logo_image = true
            endif

            if logo_display == 'text' or logo_display == 'image_and_text'
              assign show_shop_name = true
            endif

            if logo_img == blank
              assign show_shop_name = true
            endif
          -%}
          <a href="{{ routes.root_url }}" class="uly-logo{% if show_logo_image and show_shop_name %} uly-logo--image-text{% endif %}" aria-label="{{ shop.name }}">
            {%- if show_logo_image -%}
              {{
                logo_img
                | image_url: width: section.settings.logo_max_width
                | image_tag:
                  class: 'uly-logo__img',
                  alt: logo_img.alt | default: shop.name,
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '120, 180, 240, 300',
                  sizes: '(max-width: 749px) 140px, 220px'
              }}
            {%- endif -%}
            {%- if show_shop_name -%}
              <span class="uly-logo__text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>

        {%- comment -%} CENTER: Search {%- endcomment -%}
        <div class="uly-header__col uly-header__col--center">
          {% render 'header-inline-search', section: section %}
        </div>

        {%- comment -%} RIGHT: Social → Localization → Actions {%- endcomment -%}
        <div class="uly-header__col uly-header__col--right">

          {%- comment -%} 1. Social icons {%- endcomment -%}
          {% render 'header-social-icons', section: section %}

          {%- comment -%} 3. Localization — desktop only, hidden on mobile via CSS {%- endcomment -%}
          {%- if show_localization -%}
            <div class="uly-localization-slot uly-localization-slot--header">
              {% render 'uly-header-localization',
                section: section,
                show_country: show_country,
                show_language: show_language,
                id_suffix: ''
              %}
            </div>
          {%- endif -%}

          {%- comment -%} 4. Account + Cart {%- endcomment -%}
          <div class="uly-header-actions-wrapper{% if section.settings.show_account == false %} hide-account{% endif %}{% if section.settings.show_cart == false %} hide-cart{% endif %}">
            {% render 'header-actions',
              section: section,
              customer_account_menu: section.settings.customer_account_menu,
              display_style: section.settings.actions_display_style
            %}
          </div>

        </div>
      </div>
    </div>

    {% render 'uly-shop-sidebar',
      section: section,
      linklist: sidebar_menu,
      shop_label: shop_trigger_label
    %}

    {%- comment -%} Drawer host placeholder {%- endcomment -%}
    <div class="header__drawer uly-drawer-host" ref="headerDrawerContainer" data-skip-node-update="true" hidden aria-hidden="true"></div>

  </div>

  {%- comment -%} Satisfies header-component requiredRefs {%- endcomment -%}
  <div ref="headerMenu" class="uly-header-menu-placeholder" hidden aria-hidden="true"></div>
</header-component>

<script>
  (function () {
    'use strict';

    function initHeader() {
      var header = document.getElementById('header-component');
      if (!header) return;

      // Always force drawer mode — prevents Shopify's compiled CSS rule
      // #header-component[data-menu-style=menu] .header__drawer { display:none }
      header.dataset.menuStyle = 'drawer';

      // Scroll-based transparent header
      var isTransparent = header.classList.contains('uly-header--transparent');
      var THRESHOLD = 20;

      function onScroll() {
        if (window.scrollY > THRESHOLD) {
          header.setAttribute('data-scrolled', 'true');
        } else {
          header.removeAttribute('data-scrolled');
        }
      }

      if (isTransparent) {
        if (header._ulyScrollHandler) {
          window.removeEventListener('scroll', header._ulyScrollHandler);
        }
        header._ulyScrollHandler = onScroll;
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // Sync CSS height variables
      function syncHeights() {
        var headerGroup = document.getElementById('header-group');
        var row = header.querySelector('.uly-header__row');
        var rightCluster = header.querySelector('.uly-header__col--right');
        var rowH = row ? row.offsetHeight : 64;
        var barH = 0;
        var componentH = rowH;
        var groupH = headerGroup ? headerGroup.offsetHeight : componentH;
        var rightClusterW = rightCluster ? Math.ceil(rightCluster.offsetWidth) : 260;
        document.body.style.setProperty('--uly-shop-bar-height', barH + 'px');
        document.body.style.setProperty('--header-height', componentH + 'px');
        document.body.style.setProperty('--header-group-height', groupH + 'px');
        header.style.setProperty('--uly-right-cluster-width', rightClusterW + 'px');

        if (row) {
          var sidebarTop = Math.round(row.getBoundingClientRect().bottom);
          document.documentElement.style.setProperty('--uly-sidebar-top', sidebarTop + 'px');
        }
      }

      syncHeights();
      window.addEventListener('resize', syncHeights);
      requestAnimationFrame(syncHeights);
      setTimeout(syncHeights, 300);

      if (typeof ResizeObserver !== 'undefined') {
        var ro = new ResizeObserver(syncHeights);
        var row = header.querySelector('.uly-header__row');
        if (row) ro.observe(row);
      }

      function initShopDrawerFallback() {
        var trigger = header.querySelector('#uly-shop-drawer-trigger');
        var sidebar = header.querySelector('#uly-shop-sidebar, .uly-shop-sidebar');
        if (!trigger || !sidebar || trigger.dataset.ulyDrawerFallbackReady === 'true') return;

        trigger.dataset.ulyDrawerFallbackReady = 'true';

        function getFocusableItems() {
          return Array.prototype.slice.call(
            sidebar.querySelectorAll(
              'a[href], button:not([disabled]), summary, input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )
          ).filter(function (item) {
            return item.offsetParent !== null;
          });
        }

        function setPanelState(panel, isOpen) {
          if (!panel) return;
          panel.hidden = !isOpen;
          panel.toggleAttribute('hidden', !isOpen);
          panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
          panel.classList.toggle('is-open', isOpen);
          panel.classList.toggle('is-expanded', isOpen);
        }

        function setToggleState(toggle, isOpen) {
          if (!toggle) return;
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          toggle.classList.toggle('is-open', isOpen);
          toggle.classList.toggle('is-expanded', isOpen);
          var parent = toggle.closest('li, .uly-shop-sidebar__item, .uly-shop-sidebar__menu-item, .uly-shop-sidebar__group');
          if (parent) {
            parent.classList.toggle('is-open', isOpen);
            parent.classList.toggle('is-expanded', isOpen);
          }
        }

        function getControlledPanel(toggle) {
          var controls = toggle.getAttribute('aria-controls');
          if (controls) {
            try {
              var controlled = sidebar.querySelector('#' + CSS.escape(controls));
              if (controlled) return controlled;
            } catch (error) {
              var fallbackControlled = sidebar.querySelector('[id="' + controls.replace(/"/g, '\\"') + '"]');
              if (fallbackControlled) return fallbackControlled;
            }
          }

          var parent = toggle.closest('li, .uly-shop-sidebar__item, .uly-shop-sidebar__menu-item, .uly-shop-sidebar__group');
          if (!parent) return null;
          return parent.querySelector(
            ':scope > ul, :scope > .uly-shop-sidebar__submenu, :scope > .uly-shop-sidebar__children, :scope > .uly-shop-sidebar__sublist, :scope > .submenu, :scope > .children'
          );
        }

        function closeSiblingSubmenus(toggle) {
          var parent = toggle.closest('li, .uly-shop-sidebar__item, .uly-shop-sidebar__menu-item, .uly-shop-sidebar__group');
          var list = parent && parent.parentElement;
          if (!list) return;

          Array.prototype.forEach.call(
            list.querySelectorAll(':scope > li > [aria-expanded="true"], :scope > .uly-shop-sidebar__item > [aria-expanded="true"], :scope > .uly-shop-sidebar__menu-item > [aria-expanded="true"]'),
            function (siblingToggle) {
              if (siblingToggle === toggle) return;
              var siblingPanel = getControlledPanel(siblingToggle);
              setToggleState(siblingToggle, false);
              setPanelState(siblingPanel, false);
            }
          );
        }

        function initialiseSubmenus() {
          var toggles = sidebar.querySelectorAll(
            '[data-uly-submenu-toggle], [data-submenu-toggle], button.uly-shop-sidebar__submenu-toggle[aria-controls][aria-expanded]'
          );

          Array.prototype.forEach.call(toggles, function (toggle) {
            if (toggle.dataset.ulySubmenuReady === 'true') return;

            var panel = getControlledPanel(toggle);
            if (!panel) return;

            toggle.dataset.ulySubmenuReady = 'true';
            panel.classList.add('uly-shop-sidebar__submenu-panel');

            var startsOpen = toggle.getAttribute('aria-expanded') === 'true' || toggle.classList.contains('is-open');
            setToggleState(toggle, startsOpen);
            setPanelState(panel, startsOpen);

            toggle.addEventListener('click', function (event) {
              event.preventDefault();
              event.stopPropagation();
              var nextState = toggle.getAttribute('aria-expanded') !== 'true';
              closeSiblingSubmenus(toggle);
              setToggleState(toggle, nextState);
              setPanelState(panel, nextState);
            });
          });

          Array.prototype.forEach.call(
            sidebar.querySelectorAll(
              'li, .uly-shop-sidebar__item, .uly-shop-sidebar__menu-item, .uly-shop-sidebar__group'
            ),
            function (item) {
              if (item.dataset.ulyAutoDropdownReady === 'true') return;

              var panel = item.querySelector(
                ':scope > ul, :scope > .uly-shop-sidebar__submenu, :scope > .uly-shop-sidebar__children, :scope > .uly-shop-sidebar__sublist, :scope > .submenu, :scope > .children'
              );
              if (!panel) return;

              var toggle = item.querySelector(':scope > .uly-shop-sidebar__parent-row > [data-uly-submenu-toggle], :scope > [data-uly-submenu-toggle]');
              if (!toggle || toggle.dataset.ulySubmenuReady === 'true') return;

              item.dataset.ulyAutoDropdownReady = 'true';
              toggle.dataset.ulySubmenuReady = 'true';
              toggle.classList.add('uly-shop-sidebar__submenu-toggle');
              panel.classList.add('uly-shop-sidebar__submenu-panel');

              if (!toggle.hasAttribute('aria-expanded')) {
                toggle.setAttribute('aria-expanded', 'false');
              }

              if (!panel.id) {
                panel.id = 'uly-shop-submenu-' + Math.random().toString(36).slice(2);
              }
              toggle.setAttribute('aria-controls', panel.id);

              setToggleState(toggle, false);
              setPanelState(panel, false);

              toggle.addEventListener('click', function (event) {
                event.preventDefault();
                event.stopPropagation();
                var nextState = toggle.getAttribute('aria-expanded') !== 'true';
                closeSiblingSubmenus(toggle);
                setToggleState(toggle, nextState);
                setPanelState(panel, nextState);
              });
            }
          );

          Array.prototype.forEach.call(sidebar.querySelectorAll('details'), function (details) {
            if (details.dataset.ulyDetailsReady === 'true') return;
            details.dataset.ulyDetailsReady = 'true';
            var summary = details.querySelector('summary');
            if (!summary) return;
            summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
            details.addEventListener('toggle', function () {
              summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
              details.classList.toggle('is-open', details.open);
            });
          });
        }

        function markSubmenuParents() {
          Array.prototype.forEach.call(
            sidebar.querySelectorAll('li, .uly-shop-sidebar__item, .uly-shop-sidebar__menu-item, .uly-shop-sidebar__group'),
            function (item) {
              var panel = item.querySelector(
                ':scope > ul, :scope > .uly-shop-sidebar__submenu, :scope > .uly-shop-sidebar__children, :scope > .uly-shop-sidebar__sublist, :scope > .submenu, :scope > .children'
              );
              if (!panel) return;

              var label = item.querySelector(
                ':scope > a, :scope > button, :scope > .uly-shop-sidebar__link, :scope > .uly-shop-sidebar__toggle, :scope > .uly-shop-sidebar__submenu-toggle'
              );
              if (!label) return;

              item.classList.add('uly-shop-sidebar__has-children');
              label.classList.add('uly-shop-sidebar__has-children-link');
            }
          );
        }

        function openDrawer() {
          trigger.setAttribute('aria-expanded', 'true');
          sidebar.hidden = false;
          sidebar.removeAttribute('hidden');
          sidebar.setAttribute('aria-hidden', 'false');
          header.classList.add('uly-shop-sidebar-is-open');
          sidebar.classList.add('is-open', 'uly-shop-sidebar--open');
          document.body.classList.add('uly-shop-sidebar-is-open');
          markSubmenuParents();
          initialiseSubmenus();
          var firstFocusable = getFocusableItems()[0];
          if (firstFocusable && window.matchMedia('(min-width: 750px)').matches) {
            setTimeout(function () {
              firstFocusable.focus({ preventScroll: true });
            }, 30);
          }
        }

        function closeDrawer() {
          trigger.setAttribute('aria-expanded', 'false');
          sidebar.setAttribute('aria-hidden', 'true');
          header.classList.remove('uly-shop-sidebar-is-open');
          sidebar.classList.remove('is-open', 'uly-shop-sidebar--open');
          document.body.classList.remove('uly-shop-sidebar-is-open');
          Array.prototype.forEach.call(sidebar.querySelectorAll('[data-uly-submenu-toggle][aria-expanded="true"]'), function (toggle) {
            var panel = getControlledPanel(toggle);
            setToggleState(toggle, false);
            setPanelState(panel, false);
          });
          sidebar.hidden = true;
        }

        function toggleDrawer(event) {
          event.preventDefault();
          if (trigger.getAttribute('aria-expanded') === 'true') {
            closeDrawer();
          } else {
            if (window.scrollY > 10) {
              window.scrollTo({ top: 0, behavior: 'smooth' });
              window.setTimeout(openDrawer, 160);
            } else {
              openDrawer();
            }
          }
        }

        trigger.addEventListener('click', toggleDrawer);

        sidebar.addEventListener('click', function (event) {
          var link = event.target.closest('a[href]');
          if (link && !event.target.closest('[data-uly-submenu-toggle], [data-submenu-toggle], .uly-shop-sidebar__toggle, .uly-shop-sidebar__submenu-toggle, button[aria-expanded]')) {
            return;
          }

          var closeButton = event.target.closest(
            '[data-uly-shop-sidebar-close], [data-drawer-close], [data-close], .uly-shop-sidebar__close, .uly-shop-sidebar__close-button, [aria-label="Close"], [aria-label="Close menu"], button[name="close"]'
          );
          if (closeButton) closeDrawer();
        });

        document.addEventListener('click', function (event) {
          if (trigger.getAttribute('aria-expanded') !== 'true') return;
          if (sidebar.contains(event.target) || trigger.contains(event.target)) return;
          closeDrawer();
        });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
            closeDrawer();
          }
        });

        markSubmenuParents();
        initialiseSubmenus();

        if (trigger.getAttribute('aria-expanded') !== 'true') {
          closeDrawer();
        }
      }

      initShopDrawerFallback();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }

    document.addEventListener('shopify:section:load', function () {
      requestAnimationFrame(function () {
        requestAnimationFrame(initHeader);
      });
    });

    document.addEventListener('shopify:block:select', function () {
      requestAnimationFrame(initHeader);
    });
  })();
</script>

<script src="{{ 'header.js' | asset_url }}" type="module"></script>
{{ 'custom-header.css' | asset_url | stylesheet_tag }}
{{ 'uly-shop-sidebar.css' | asset_url | stylesheet_tag }}

{% stylesheet %}
  /* ── Admin editor critical overrides ── */

  body {
    --header-height: 64px;
    --uly-shop-bar-height: 0px;
    --header-row-height: 64px;
    --header-group-height: 64px;
    --transparent-header-offset-boolean: 0;
  }

  #header-group:has(#header-component[sticky]) {
    display: contents;
  }

  .header-section:has(.uly-header--transparent) {
    height: 0;
    min-height: 0;
    overflow: visible;
  }

  .uly-header .header__drawer.uly-drawer-host {
    display: none !important;
    min-height: 0 !important;
    pointer-events: none;
  }

  .uly-header-menu-placeholder { display: none !important; }

  .uly-header {
    --header-padding: 0 var(--padding-lg);
    display: block;
    background: transparent;
    font-family: var(--primary-font, sans-serif);
  }

  .uly-header__shell { position: relative; }

  .header-section:has(> #header-component[sticky='always']),
  .header-section:has(> #header-component[sticky='scroll-up'][data-sticky-state='active']) {
    position: sticky;
    top: -1px;
    z-index: var(--layer-sticky);
  }

  .header-section:has(> #header-component.uly-shop-sidebar-is-open) {
    position: relative !important;
    top: auto !important;
  }

  .uly-header__underlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .uly-header__underlay--closed {
    height: 100%;
    z-index: var(--layer-lowest);
    background: var(--color-background);
    display: none;
  }
  .uly-header__underlay--open { height: 0; display: none; }

  .uly-header__row {
    position: relative;
    background-color: transparent;
    border-block: 1px solid rgba(var(--color-foreground-rgb), 0.85);
    background-color: var(--uly-header-background-color, var(--color-pale-peach, #FFE8DD));
    margin-inline: 0 !important;
    padding-inline: 0 !important;
  }

  .uly-header.uly-shop-sidebar-is-open .uly-header__row {
    background-color: var(--uly-header-background-color, var(--color-pale-peach, #FFE8DD)) !important;
    border-block-color: rgba(14, 92, 102, 0.12) !important;
  }

  .uly-header__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: var(--header-row-height, 64px);
    padding: 0.5rem 0;
    gap: 0;
  }

  .uly-header__col {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 0.5rem);
  }
  .uly-header__col--left {
    justify-content: flex-start;
    min-width: 0;
    max-width: calc(50% - 320px);
  }
  .uly-header__col--center {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: min(560px, 36vw);
    transform: translate(-50%, -50%);
    justify-content: center;
    min-width: 220px;
    pointer-events: auto;
  }
  .uly-header__col--right {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    z-index: 3;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: nowrap;
    gap: 0.5rem;
    min-width: max-content;
  }

  .uly-header__col--right > * {
    flex-shrink: 0;
  }

  .uly-header__col--center > * {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }

  .uly-localization-slot--header {
    order: 3;
    margin-inline: 0.15rem;
  }

  .uly-header-actions-wrapper {
    order: 4;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    width: auto;
    overflow: visible;
  }

  .uly-header-actions-wrapper header-actions {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap;
    width: auto;
    overflow: visible;
  }

  .uly-header-actions-wrapper .header-actions__action,
  .uly-header-actions-wrapper cart-icon,
  .uly-header-actions-wrapper .header-actions__cart-icon,
  .uly-header-actions-wrapper cart-drawer-component,
  .uly-header-actions-wrapper .cart-drawer {
    overflow: visible !important;
  }

