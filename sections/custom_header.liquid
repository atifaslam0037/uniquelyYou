      min-width: 40px;
      min-height: 40px;
      justify-content: center;
      padding: 0 !important;
    }
    .uly-header-search { margin-inline: 0; }
    .uly-header-search,
    .uly-header-search form,
    .uly-header-search .search,
    .uly-header-search .search-modal__form,
    .uly-header-search .field,
    .uly-header-search .search__form,
    .uly-header-search .predictive-search {
      width: auto;
      min-width: 0;
      border: 0 !important;
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }
    .uly-header-search input[type='search'],
    .uly-header-search input[type='text'],
    .uly-header-search .field__input,
    .uly-header-search .search__input,
    .uly-header-search .predictive-search__input,
    .uly-header-search [data-search-input],
    .uly-header-search__placeholder,
    .uly-header-search__label {
      display: none !important;
    }
    .uly-header-search button,
    .uly-header-search .button,
    .uly-header-search .search__button,
    .uly-header-search .search-modal__button,
    .uly-header-search .header-actions__action,
    .uly-header-search__trigger {
      width: 32px;
      height: 40px;
      min-width: 32px;
      min-height: 40px;
      padding: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }
    .uly-shop-bar__suffix { display: none; }
    .uly-localization-slot--header { display: flex !important; }
    .uly-localization-slot--bar { display: none !important; }

    #uly-shop-sidebar .uly-shop-sidebar__mobile-actions,
    .uly-shop-sidebar .uly-shop-sidebar__mobile-actions {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
      flex-wrap: wrap !important;
      gap: 0.35rem !important;
      margin-top: 1.25rem !important;
      padding-top: 1rem !important;
      border-top: 1px solid rgba(255, 255, 255, 0.22) !important;
    }

    #uly-shop-sidebar .uly-shop-sidebar__mobile-actions .uly-header-social,
    .uly-shop-sidebar .uly-shop-sidebar__mobile-actions .uly-header-social {
      display: inline-flex !important;
    }

    #uly-shop-sidebar .uly-shop-sidebar__mobile-actions .uly-header-social__link,
    .uly-shop-sidebar .uly-shop-sidebar__mobile-actions .uly-header-social__link {
      color: #fff !important;
    }
  }

  #header-component .uly-header-search--with-label,
  #header-component .uly-header-search--with-label .uly-header-search__label {
    background: transparent !important;
  }

  @media screen and (min-width: 1181px) {
    #header-component .uly-header-search--with-label .uly-header-search__trigger {
      background: var(--uly-search-trigger-background-color, #FFFFFF) !important;
    }
  }

  @media screen and (max-width: 1180px) {
    #header-component .uly-header-search--with-label .uly-header-search__trigger search-button,
    #header-component .uly-header-search--with-label .uly-header-search__trigger .search-action,
    #header-component .uly-header-search--with-label .uly-header-search__trigger .button-unstyled.header-actions__action,
    #header-component .uly-header-search--with-label .uly-header-search__trigger button.button-unstyled.header-actions__action,
    #header-component .uly-header-search search-button,
    #header-component .uly-header-search .search-action,
    #header-component .uly-header-search .search-action button,
    #header-component .uly-header-search .header-actions__action {
      background: transparent !important;
      background-color: transparent !important;
    }
  }

  #header-component .uly-header-actions-wrapper .header-actions__action[data-testid='cart-drawer-trigger'],
  #header-component .uly-header-actions-wrapper .header-actions__action.action__cart {
    width: 46px !important;
    min-width: 46px !important;
    height: 44px !important;
    min-height: 44px !important;
    overflow: visible !important;
  }

  #header-component .uly-header-actions-wrapper .header-actions__cart-icon.header-actions__cart-icon--has-cart svg,
  #header-component .uly-header-actions-wrapper cart-icon.header-actions__cart-icon--has-cart svg {
    mask: none !important;
    -webkit-mask: none !important;
  }

  #header-component .uly-header-actions-wrapper .header-actions__cart-icon .cart-bubble {
    width: 18px !important;
    height: 18px !important;
    /* top: -1px !important; */
    /* right: -2px !important; */
    transform: none !important;
    border-radius: 999px !important;
    color: #fff !important;
  }

  #header-component .uly-header-actions-wrapper .header-actions__cart-icon .cart-bubble__background {
    background: #000 !important;
    background-color: #000 !important;
    border-radius: 999px !important;
  }

  #header-component .uly-header-actions-wrapper .header-actions__cart-icon .cart-bubble__text,
  #header-component .uly-header-actions-wrapper .header-actions__cart-icon .cart-bubble__text-count {
    position: static !important;
    width: 100% !important;
    height: 100% !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    color: #fff !important;
    font-size: 10px !important;
    line-height: 1 !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  /* Desktop */
  @media screen and (min-width: 750px) {
    .uly-localization-slot--header { display: flex !important; }
    .uly-localization-slot--bar { display: none !important; }
  }
{% endstylesheet %}

{% unless request.design_mode %}
  <script type="module">
    import { hydrate } from '@theme/section-hydration';
    const url = new URL(window.location.href);
    url.searchParams.delete('page');
    hydrate('{{ section.id }}', url);
  </script>
{% endunless %}

{% schema %}
{
  "name": "Custom Header",
  "tag": "header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Overrides the global logo setting."
    },
    {
      "type": "select",
      "id": "logo_display",
      "label": "Logo display",
      "options": [
        { "value": "auto", "label": "Logo if available, otherwise shop name" },
        { "value": "image", "label": "Logo only" },
        { "value": "text", "label": "Shop name only" },
        { "value": "image_and_text", "label": "Logo and shop name" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Sidebar menu",
      "default": "main-menu",
      "info": "Use your Shop All navigation menu (handle: shop-all). Nested links appear in the sidebar."
    },
    {
      "type": "url",
      "id": "shop_all_collections_url",
      "label": "Shop All collections link",
      "info": "Top link in the sidebar (e.g. all collections page). Leave blank for /collections."
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop button label",
      "info": "Leave blank to use the navigation menu title.",
      "default": "Shop All"
    },
    {
      "type": "text",
      "id": "shop_all_suffix",
      "label": "Shop button suffix",
      "info": "Optional text after the arrow, e.g. Collections:",
      "default": "Collections:"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search_placeholder",
      "label": "Show search placeholder text",
      "default": false,
      "visible_if": "{{ section.settings.show_search }}"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder text",
      "default": "Find what makes you unique!",
      "visible_if": "{{ section.settings.show_search and section.settings.show_search_placeholder }}"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter URL"
    },
    {
      "type": "header",
      "content": "Language & Currency"
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Show country/currency selector",
      "default": true,
      "info": "Requires multiple markets in Shopify Markets. Always visible in the theme editor when enabled."
    },
    {
      "type": "checkbox",
      "id": "country_selector_style",
      "label": "Show country flag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Action Icons"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Sidebar Menu Options"
    },
    {
      "type": "checkbox",
      "id": "drawer_accordion",
      "label": "Accordion sub-menus",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "drawer_accordion_expand_first",
      "label": "Auto-expand first item",
      "default": false,
      "visible_if": "{{ section.settings.drawer_accordion }}"
    },
    {
      "type": "checkbox",
      "id": "drawer_dividers",
      "label": "Show dividers between items",
      "default": true
    },
    {
      "type": "select",
      "id": "menu_style",
      "label": "Sidebar menu style",
      "options": [
        { "value": "text", "label": "Text only" },
        { "value": "collection_images", "label": "Collection images" },
        { "value": "featured_collections", "label": "Featured collections" },
        { "value": "featured_products", "label": "Featured products" }
      ],
      "default": "text"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Sidebar color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "header_background_color",
      "label": "Header background color",
      "default": "#FFE8DD"
    },
    {
      "type": "color",
      "id": "search_trigger_background_color",
      "label": "Desktop search button background color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_home",
      "label": "Transparent header on homepage",
      "default": true
    },
    {
      "type": "select",
      "id": "sticky_style",
      "label": "Sticky header background",
      "options": [
        { "value": "glassmorphism", "label": "Glass (blur + teal tint)" },
        { "value": "solid", "label": "Solid color scheme background" }
      ],
      "default": "glassmorphism"
    },
    {
      "type": "select",
      "id": "actions_display_style",
      "label": "Icons display style",
      "options": [
        { "value": "icon", "label": "Icons" },
        { "value": "text", "label": "Text" }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "enable_sticky_header",
      "label": "Sticky header",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "scroll-up", "label": "On scroll up" },
        { "value": "never", "label": "Never" }
      ],
      "default": "always"
    }
  ],
  "presets": []
}
{% endschema %}
