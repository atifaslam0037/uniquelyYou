<style>
  /* ================================================================
     ABOUT STORY SECTION — about-story.liquid
     Two-column: image left, content right (reversible)
  ================================================================ */

  #about-story-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  #about-story-{{ section.id }} .about-story__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Two-column grid */
  #about-story-{{ section.id }} .about-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.column_gap }}px;
    align-items: center;
    {% if section.settings.reverse_layout %}
      direction: rtl;
    {% endif %}
  }

  #about-story-{{ section.id }} .about-story__grid > * {
    direction: ltr;
  }

  /* Image column */
  #about-story-{{ section.id }} .about-story__image-wrap {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    line-height: 0;
  }

  #about-story-{{ section.id }} .about-story__image-wrap img,
  #about-story-{{ section.id }} .about-story__image-wrap svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: {{ section.settings.image_radius }}px;
  }

  /* Content column */
  #about-story-{{ section.id }} .about-story__content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Badge — plain small orange uppercase text, no background */
  #about-story-{{ section.id }} .about-story__badge {
    display: block;
    font-family: var(--primary-font);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.badge_color }};
    margin-bottom: 14px;
    line-height: 1;
  }

  /* Heading */
  #about-story-{{ section.id }} .about-story__heading {
    font-family: var(--primary-font);
    font-size: clamp(28px, 3.5vw, {{ section.settings.heading_size }}px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px;
  }

  /* Rich text body — rte class handles Shopify paragraph/list spacing */
  #about-story-{{ section.id }} .about-story__rte {
    font-family: var(--primary-font);
    font-size: clamp(14px, 1.3vw, 15px);
    line-height: 1.75;
    color: {{ section.settings.text_color }};
    margin: 0 0 28px;
  }

  #about-story-{{ section.id }} .about-story__rte p {
    margin: 0 0 16px;
  }

  #about-story-{{ section.id }} .about-story__rte p:last-child {
    margin-bottom: 0;
  }

  #about-story-{{ section.id }} .about-story__rte a {
    color: {{ section.settings.badge_color }};
    text-decoration: underline;
  }

  #about-story-{{ section.id }} .about-story__rte ul,
  #about-story-{{ section.id }} .about-story__rte ol {
    padding-left: 20px;
    margin: 0 0 16px;
  }

  #about-story-{{ section.id }} .about-story__rte li {
    margin-bottom: 6px;
  }

  /* Signature block */
  #about-story-{{ section.id }} .about-story__signature {
    margin-top: 8px;
    padding-top: 24px;
    border-top: 1px solid rgba(0,0,0,0.08);
  }

  #about-story-{{ section.id }} .about-story__signature-name {
    font-family: var(--primary-font);
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 400;
    font-style: italic;
    color: {{ section.settings.heading_color }};
    margin: 0 0 4px;
    line-height: 1.3;
  }

  #about-story-{{ section.id }} .about-story__signature-role {
    font-family: var(--primary-font);
    font-size: 13px;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
    line-height: 1;
  }

  /* ── TABLET ── */
  @media screen and (max-width: 1023px) {
    #about-story-{{ section.id }} .about-story__container {
      padding: 0 24px;
    }

    #about-story-{{ section.id }} .about-story__grid {
      gap: 32px;
    }
  }

  /* ── MOBILE ── */
  @media screen and (max-width: 749px) {
    #about-story-{{ section.id }} .about-story__container {
      padding: 0 20px;
    }

    #about-story-{{ section.id }} .about-story__grid {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 28px;
    }

    /* On mobile image always comes first regardless of reverse setting */
    #about-story-{{ section.id }} .about-story__image-wrap {
      order: -1;
    }
  }
</style>

<div id="about-story-{{ section.id }}">
  <div class="about-story__container">
    <div class="about-story__grid">

      {%- comment -%} Image column {%- endcomment -%}
      <div class="about-story__image-wrap">
        {%- if section.settings.image != blank -%}
          <img
            srcset="
              {{ section.settings.image | image_url: width: 400 }} 400w,
              {{ section.settings.image | image_url: width: 700 }} 700w,
              {{ section.settings.image | image_url: width: 1000 }} 1000w
            "
            sizes="(max-width: 749px) 100vw, 50vw"
            src="{{ section.settings.image | image_url: width: 700 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      {%- comment -%} Content column {%- endcomment -%}
      <div class="about-story__content">

        {%- if section.settings.badge_text != blank -%}
          <span class="about-story__badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="about-story__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="about-story__rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.signature_name != blank or section.settings.signature_role != blank -%}
          <div class="about-story__signature">
            {%- if section.settings.signature_name != blank -%}
              <p class="about-story__signature-name">{{ section.settings.signature_name }}</p>
            {%- endif -%}
            {%- if section.settings.signature_role != blank -%}
              <p class="about-story__signature-role">{{ section.settings.signature_role }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Story",
  "tag": "section",
  "class": "section-about-story",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Recommended: 900 x 700px"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Our Story"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#E8612C"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "It started with a simple idea."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (desktop max)",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0E5C66"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We wanted a place where creativity meets quality—where you can express what matters most to you through designs that are fun, thoughtful, and made to last.</p><p>From original one-liners to custom creations, every piece is printed on premium materials with care and purpose.</p><p>This isn't just a brand. It's a community of people who choose authenticity, kindness, and self-expression—together.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#444444"
    },
    {
      "type": "header",
      "content": "Signature"
    },
    {
      "type": "text",
      "id": "signature_name",
      "label": "Signature Name",
      "default": "Todd & Fran",
      "info": "Displays in italic script style below the description."
    },
    {
      "type": "text",
      "id": "signature_role",
      "label": "Signature Role / Title",
      "default": "Founders of Uniquely You"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse Layout (image on right)",
      "default": false
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap Between Columns",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "About Story"
    }
  ]
}
{% endschema %}
