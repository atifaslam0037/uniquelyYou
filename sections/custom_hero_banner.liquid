{% liquid
  assign slide_count = section.blocks.size
  assign autoplay_ms = section.settings.autoplay_speed | times: 1000
%}

<section
  class="uy-carousel uy-carousel--{{ section.id }}{% unless section.settings.show_overlay %} uy-carousel--no-overlay{% endunless %}"
  data-uy-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-ms="{{ autoplay_ms }}"
  style="
    --uy-teal: {{ section.settings.teal }};
    --uy-teal-dark: {{ section.settings.teal_dark }};
    --uy-orange: {{ section.settings.orange }};
    --uy-cream: {{ section.settings.cream }};
    --uy-white: {{ section.settings.white }};
    --uy-heading-size: {{ section.settings.heading_size }}px;
    --uy-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --uy-copy-width: {{ section.settings.copy_width }}px;
    --uy-primary-button-bg: {{ section.settings.primary_button_bg }};
    --uy-primary-button-text: {{ section.settings.primary_button_text }};
    --uy-secondary-button-bg: {{ section.settings.secondary_button_bg }};
    --uy-secondary-button-text: {{ section.settings.secondary_button_text }};
    --uy-secondary-button-border: {{ section.settings.secondary_button_border }};
  "
>
  <div class="uy-carousel__viewport" aria-roledescription="carousel" aria-label="{{ section.settings.accessibility_label | escape }}">
    <div class="uy-carousel__track" data-uy-track>
      {% for block in section.blocks %}
        <article
          class="uy-carousel__slide{% if forloop.first %} is-active{% endif %}"
          data-uy-slide
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ slide_count }}"
          {{ block.shopify_attributes }}
        >
          <div class="uy-carousel__image-wrap">
            {% if block.settings.image != blank %}
              {% if forloop.first %}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: 'eager',
                    fetchpriority: 'high',
                    widths: '750, 1100, 1500, 1800, 2200, 2400',
                    sizes: '100vw',
                    class: 'uy-carousel__image',
                    alt: block.settings.image.alt
                }}
              {% else %}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: 'lazy',
                    widths: '750, 1100, 1500, 1800, 2200, 2400',
                    sizes: '100vw',
                    class: 'uy-carousel__image',
                    alt: block.settings.image.alt
                }}
              {% endif %}
            {% else %}
              <div class="uy-carousel__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="uy-carousel__overlay"></div>

          <div class="uy-carousel__content">
            {% if block.settings.badge != blank %}
              <p class="uy-carousel__badge">{{ block.settings.badge }}</p>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2>{{ block.settings.heading }}</h2>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="uy-carousel__text">{{ block.settings.text }}</div>
            {% endif %}

            <div class="uy-carousel__actions">
              {% if block.settings.primary_label != blank %}
                <a class="uy-carousel__button uy-carousel__button--primary" href="{{ block.settings.primary_link }}">
                  {{ block.settings.primary_label }}
                </a>
              {% endif %}

              {% if block.settings.secondary_label != blank %}
                <a class="uy-carousel__button uy-carousel__button--secondary" href="{{ block.settings.secondary_link }}">
                  {{ block.settings.secondary_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    {% if slide_count > 1 %}
      <button class="uy-carousel__arrow uy-carousel__arrow--prev" type="button" data-uy-prev aria-label="Previous slide">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>

      <button class="uy-carousel__arrow uy-carousel__arrow--next" type="button" data-uy-next aria-label="Next slide">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>

      <div class="uy-carousel__dots" role="tablist" aria-label="Choose slide">
        {% for block in section.blocks %}
          <button
            class="uy-carousel__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-uy-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .uy-carousel--{{ section.id }} {
    color: var(--uy-white);
  }

  .uy-carousel--{{ section.id }} * {
    box-sizing: border-box;
  }

  .uy-carousel__viewport {
    position: relative;
    height: min(780px, calc(100svh - 18px));
    min-height: 620px;
    overflow: hidden;
    border-radius: {{ section.settings.corner_radius }}px;
    background: var(--uy-teal-dark);
    isolation: isolate;
  }

  .uy-carousel__track,
  .uy-carousel__slide {
    position: absolute;
    inset: 0;
  }

  .uy-carousel__slide {
    opacity: 0;
    pointer-events: none;
    transform: scale(1.018);
    transition: opacity 760ms ease, transform 1100ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .uy-carousel__slide.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
    z-index: 1;
  }

  .uy-carousel__image-wrap,
  .uy-carousel__overlay,
  .uy-carousel__image,
  .uy-carousel__placeholder,
  .uy-carousel__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .uy-carousel__image,
  .uy-carousel__placeholder svg {
    display: block;
    object-fit: cover;
    transform: scale(1.035);
    transition: transform 5200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .uy-carousel__slide.is-active .uy-carousel__image,
  .uy-carousel__slide.is-active .uy-carousel__placeholder svg {
    transform: scale(1);
  }

  .uy-carousel__overlay {
    background:
      linear-gradient(90deg, rgba(0, 75, 78, 0.9) 0%, rgba(0, 91, 94, 0.7) 36%, rgba(0, 75, 78, 0.22) 72%, rgba(0, 75, 78, 0.04) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.04));
  }

  .uy-carousel--no-overlay .uy-carousel__overlay {
    display: none;
  }

  .uy-carousel__content {
    position: relative;
    z-index: 2;
    width: min(var(--uy-copy-width), calc(100% - 128px));
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(116px, 14vh, 148px) 0 clamp(82px, 10vh, 112px);
    margin-left: clamp(56px, 7vw, 128px);
  }

  .uy-carousel__badge,
  .uy-carousel__content h2,
  .uy-carousel__text,
  .uy-carousel__actions {
    opacity: 0;
    transform: translateY(18px);
  }

  .uy-carousel__slide.is-active .uy-carousel__badge,
  .uy-carousel__slide.is-active .uy-carousel__content h2,
  .uy-carousel__slide.is-active .uy-carousel__text,
  .uy-carousel__slide.is-active .uy-carousel__actions {
    animation: uyCarouselTextIn 820ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .uy-carousel__slide.is-active .uy-carousel__content h2 {
    animation-delay: 90ms;
  }

  .uy-carousel__slide.is-active .uy-carousel__text {
    animation-delay: 170ms;
  }

  .uy-carousel__slide.is-active .uy-carousel__actions {
    animation-delay: 240ms;
  }

  .uy-carousel__badge {
    align-self: flex-start;
    margin: 0 0 clamp(28px, 4vw, 48px);
    padding: 12px 28px;
    color: var(--uy-white);
    background: var(--uy-orange);
    border-radius: 999px;
    font-size: clamp(13px, 1vw, 18px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .uy-carousel__content h2 {
    max-width: 740px;
    margin: 0;
    color: var(--uy-white);
    font-size: clamp(46px, 5.2vw, var(--uy-heading-size));
    line-height: 1.03;
    font-weight: 900;
    letter-spacing: 0;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.24);
  }

  .uy-carousel__text {
    max-width: min(650px, 100%);
    margin-top: clamp(16px, 2vw, 26px);
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(17px, 1.45vw, 24px);
    line-height: 1.5;
    font-weight: 700;
    text-shadow: 0 3px 18px rgba(0, 0, 0, 0.22);
  }

  .uy-carousel__text p {
    margin: 0;
  }

  .uy-carousel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .uy-carousel__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 900;
    text-decoration: none;
  }

  .uy-carousel__button--primary {
    color: var(--uy-primary-button-text);
    background: var(--uy-primary-button-bg);
  }

  .uy-carousel__button--secondary {
    color: var(--uy-secondary-button-text);
    border: 1px solid var(--uy-secondary-button-border);
    background: var(--uy-secondary-button-bg);
    backdrop-filter: blur(16px);
  }

  .uy-carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 4;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.36);
    border-radius: 50%;
    color: var(--uy-white);
    background: rgba(0, 75, 78, 0.42);
    cursor: pointer;
    transform: translateY(-50%);
    backdrop-filter: blur(14px);
  }

  .uy-carousel__arrow:hover {
    background: var(--uy-orange);
    border-color: var(--uy-orange);
  }

  .uy-carousel__arrow svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.5;
  }

  .uy-carousel__arrow--prev {
    left: clamp(20px, 2vw, 38px);
  }

  .uy-carousel__arrow--next {
    right: clamp(20px, 2vw, 38px);
  }

  .uy-carousel__dots {
    position: absolute;
    left: 50%;
    bottom: clamp(28px, 4vh, 46px);
    z-index: 4;
    display: flex;
    gap: 10px;
    transform: translateX(-50%);
  }

  .uy-carousel__dot {
    width: 34px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.42);
    cursor: pointer;
  }

  .uy-carousel__dot.is-active {
    width: 54px;
    background: var(--uy-orange);
  }

  @keyframes uyCarouselTextIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .uy-carousel__slide,
    .uy-carousel__badge,
    .uy-carousel__content h2,
    .uy-carousel__text,
    .uy-carousel__actions {
      animation: none !important;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media screen and (min-width: 1400px) {
    .uy-carousel__arrow {
      width: 58px;
      height: 58px;
    }

    .uy-carousel__arrow--prev {
      left: 34px;
    }

    .uy-carousel__arrow--next {
      right: 34px;
    }
  }

  @media screen and (max-width: 989px) {
    .uy-carousel__viewport {
      height: min(680px, calc(100svh - 16px));
      min-height: unset;
    }

    .uy-carousel__overlay {
      background:
        linear-gradient(90deg, rgba(0, 75, 78, 0.92) 0%, rgba(0, 91, 94, 0.72) 58%, rgba(0, 75, 78, 0.22) 100%),
        linear-gradient(0deg, rgba(0, 0, 0, 0.22), rgba(0, 0, 0, 0.08));
    }

    .uy-carousel__content {
      width: min(620px, calc(100% - 64px));
      height: 100%;
      padding: 92px 0 86px;
      margin-left: 32px;
    }

    .uy-carousel__badge {
      margin-bottom: 24px;
      padding: 10px 22px;
    }

    .uy-carousel__arrow {
      top: auto;
      bottom: 22px;
      width: 44px;
      height: 44px;
      transform: none;
    }

    .uy-carousel__arrow--prev {
      left: auto;
      right: 88px;
    }

    .uy-carousel__arrow--next {
      right: 32px;
    }

    .uy-carousel__dots {
      left: 50%;
      bottom: 41px;
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 640px) {
    .uy-carousel__viewport {
      height: 470px;
      min-height: 0;
      border-radius: {{ section.settings.mobile_corner_radius }}px;
    }

    .uy-carousel__overlay {
      background:
        linear-gradient(90deg, rgba(0, 75, 78, 0.94) 0%, rgba(0, 91, 94, 0.74) 72%, rgba(0, 75, 78, 0.36) 100%),
        linear-gradient(0deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.08));
    }

    .uy-carousel__content {
      width: calc(100% - 32px);
      height: 100%;
      justify-content: flex-start;
      padding: 80px 0 34px;
      margin-left: 16px;
    }

    .uy-carousel__badge {
      margin-bottom: 16px;
      padding: 8px 15px;
      font-size: 12px;
    }

    .uy-carousel__content h2 {
      max-width: 95%;
      font-size: clamp(28px, 8.4vw, var(--uy-mobile-heading-size));
      line-height: 1.06;
    }

    .uy-carousel__text {
      max-width: 94%;
      margin-top: 12px;
      font-size: 14px;
      line-height: 1.34;
    }

    .uy-carousel__actions {
      flex-wrap: nowrap;
      width: min(100%, 330px);
      gap: 8px;
      margin-top: 12px;
    }

    .uy-carousel__button {
      flex: 1 1 0;
      min-width: 0;
      min-height: 42px;
      padding: 0 12px;
      font-size: 11px;
      white-space: nowrap;
    }

    .uy-carousel__arrow {
      width: 40px;
      height: 40px;
      bottom: 8px;
    }

    .uy-carousel__arrow--prev {
      right: 68px;
    }

    .uy-carousel__arrow--next {
      right: 16px;
    }

    .uy-carousel__dots {
      display:none;
      left: 50%;
      bottom: 18px;
      max-width: calc(100% - 132px);
      gap: 8px;
      transform: translateX(-50%);
    }

    .uy-carousel__dot {
      width: 26px;
      height: 5px;
    }

    .uy-carousel__dot.is-active {
      width: 38px;
    }
  }

  @media screen and (max-width: 380px) {
    .uy-carousel__viewport {
      height: 400px;
      min-height: 0;
    }

    .uy-carousel__content {
      padding-top: 90px;
      padding-bottom: 30px;
    }

    .uy-carousel__content h2 {
      font-size: 27px;
    }

    .uy-carousel__text {
      font-size: 13px;
    }

    .uy-carousel__button {
      min-height: 40px;
      padding: 0 9px;
      font-size: 11px;
    }

    .uy-carousel__dots {
      display:none;
      bottom: 16px;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('.uy-carousel--{{ section.id }}');
    if (!root) return;

    const slides = Array.from(root.querySelectorAll('[data-uy-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-uy-dot]'));
    const prev = root.querySelector('[data-uy-prev]');
    const next = root.querySelector('[data-uy-next]');
    const autoplay = root.dataset.autoplay === 'true';
    const autoplayMs = Number(root.dataset.autoplayMs || 6000);
    let activeIndex = 0;
    let timer = null;

    const setSlide = (index) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('is-active', slideIndex === activeIndex);
        slide.setAttribute('aria-hidden', slideIndex === activeIndex ? 'false' : 'true');
      });

      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle('is-active', dotIndex === activeIndex);
        dot.setAttribute('aria-selected', dotIndex === activeIndex ? 'true' : 'false');
      });
    };

    const stopAutoplay = () => {
      if (timer) window.clearInterval(timer);
      timer = null;
    };

    const startAutoplay = () => {
      if (!autoplay || slides.length < 2) return;
      stopAutoplay();
      timer = window.setInterval(() => setSlide(activeIndex + 1), autoplayMs);
    };

    prev?.addEventListener('click', () => {
      setSlide(activeIndex - 1);
      startAutoplay();
    });

    next?.addEventListener('click', () => {
      setSlide(activeIndex + 1);
      startAutoplay();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        setSlide(Number(dot.dataset.uyDot));
        startAutoplay();
      });
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);

    setSlide(0);
    startAutoplay();

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target.contains(root)) stopAutoplay();
    });
  })();
</script>

{% schema %}
