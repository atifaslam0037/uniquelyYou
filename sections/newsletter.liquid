{% comment %}
  Newsletter Signup Section
  Email subscription form with promotional messaging
{% endcomment %}

<style>
  /* Newsletter Section Styles */

  .newsletter-wrapper {
    overflow: hidden;
  }

  .newsletter-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .newsletter-content {
    background-color: var(--primary-accent);
    border-radius: 24px;
    padding: 60px 40px;
    text-align: center;
    position: relative;
  }

  .newsletter-badge {
    display: inline-block;
    background-color: var(--secondary-accent);
    color: var(--white);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 20px;
    border-radius: 20px;
    margin-bottom: 20px;
    font-family: var(--primary-font);
  }

  .newsletter-heading {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--white);
    margin-bottom: 16px;
    font-family: var(--primary-font);
  }

  .newsletter-description {
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    max-width: 600px;
    margin: 0 auto 32px;
    font-family: var(--primary-font);
  }

  .newsletter-form {
    max-width: 520px;
    margin: 0 auto;
    display: flex;
    gap: 12px;
    align-items: stretch;
  }

  .newsletter-input {
    flex: 1;
    padding: 16px 24px;
    font-size: 16px;
    border: none;
    border-radius: 50px;
    background-color: var(--white);
    color: var(--black);
    font-family: var(--primary-font);
    transition: box-shadow 0.3s ease;
  }

  .newsletter-input::placeholder {
    color: #999;
  }

  .newsletter-input:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.3);
  }

  .newsletter-button {
    padding: 16px 32px;
    font-size: 16px;
    font-weight: 600;
    border: none;
    border-radius: 50px;
    background-color: var(--secondary-accent);
    color: var(--white);
    cursor: pointer;
    font-family: var(--primary-font);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .newsletter-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(232, 97, 44, 0.4);
  }

  .newsletter-button:active {
    transform: translateY(0);
  }

  /* Success/Error Messages */
  .newsletter-message {
    margin-top: 16px;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-family: var(--primary-font);
    display: none;
  }

  .newsletter-message.success {
    background-color: rgba(255, 255, 255, 0.2);
    color: var(--white);
    display: block;
  }

  .newsletter-message.error {
    background-color: rgba(232, 97, 44, 0.2);
    color: var(--white);
    display: block;
  }

  /* Tablet Responsive */
  @media (max-width: 1023px) {
    .newsletter-container {
      padding: 0 16px;
    }

    .newsletter-content {
      padding: 50px 32px;
      border-radius: 20px;
    }

    .newsletter-badge {
      font-size: 11px;
      padding: 7px 18px;
    }

    .newsletter-description {
      margin-bottom: 28px;
    }
  }

  /* Mobile Responsive */
  @media (max-width: 767px) {
    .newsletter-container {
      padding: 0 16px;
    }

    .newsletter-content {
      padding: 40px 24px;
      border-radius: 16px;
    }

    .newsletter-badge {
      font-size: 10px;
      padding: 6px 16px;
      margin-bottom: 16px;
    }

    .newsletter-heading {
      margin-bottom: 12px;
    }

    .newsletter-description {
      margin-bottom: 24px;
    }

    .newsletter-form {
      flex-direction: column;
      gap: 12px;
    }

    .newsletter-input {
      padding: 14px 20px;
      font-size: 15px;
    }

    .newsletter-button {
      padding: 14px 28px;
      font-size: 15px;
      width: 100%;
    }

    .newsletter-message {
      font-size: 13px;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .newsletter-button {
      transition: none;
    }
  }

  /* Focus States */
  .newsletter-button:focus {
    outline: 2px solid var(--white);
    outline-offset: 2px;
  }

  /* Section Padding */
  #newsletter-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #newsletter-{{ section.id }} .newsletter-content {
    background-color: {{ section.settings.background_color | default: '#0E5C66' }};
    border-radius: {{ section.settings.border_radius }}px;
  }

  #newsletter-{{ section.id }} .newsletter-badge {
    background-color: {{ section.settings.badge_color | default: '#E8612C' }};
  }

  #newsletter-{{ section.id }} .newsletter-button {
    background-color: {{ section.settings.button_color | default: '#E8612C' }};
  }
</style>

<div class="newsletter-wrapper" id="newsletter-{{ section.id }}">
  <div class="newsletter-container">
    <div class="newsletter-content">
      {% if section.settings.badge_text != blank %}
        <span class="newsletter-badge">{{ section.settings.badge_text }}</span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="newsletter-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="newsletter-description">{{ section.settings.description }}</p>
      {% endif %}

      {% form 'contact', class: 'newsletter-form' %}
        {% if form.posted_successfully? %}
          <div class="newsletter-message success">
            {{ section.settings.success_message | default: 'Thanks for subscribing!' }}
          </div>
        {% else %}
          <input
            type="email"
            name="contact[email]"
            class="newsletter-input"
            placeholder="{{ section.settings.placeholder | default: 'you@example.com' }}"
            required
            aria-label="Email address"
          >
          <input type="hidden" name="contact[tags]" value="newsletter">
          <button
            type="submit"
            class="newsletter-button"
          >
            {{ section.settings.button_text }}
          </button>

          {% if form.errors %}
            <div class="newsletter-message error">
              {{ form.errors.messages.email | default: 'Please enter a valid email address.' }}
            </div>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

<script>
  // Newsletter form enhancement
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('#newsletter-{{ section.id }} .newsletter-form');

    if (form) {
      form.addEventListener('submit', function (e) {
        const emailInput = form.querySelector('input[type="email"]');
        const email = emailInput.value.trim();

        // Basic email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          e.preventDefault();
          alert('Please enter a valid email address.');
          return false;
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Newsletter Signup",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "JOIN THE CLUB"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Drop your email for early access to new collections and exclusive print drops."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for subscribing! Check your email for your discount code."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#0E5C66"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#E8612C"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#E8612C"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner Radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup"
    }
  ]
}
{% endschema %}
