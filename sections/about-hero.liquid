<style>
  /* ================================================================
     ABOUT HERO — Full bleed, no side padding, edge to edge
  ================================================================ */

  .about-hero-section {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  #about-hero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* Wrapper: full viewport width, no page-width container */
  #about-hero-{{ section.id }} .about-hero__wrap {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.hero_height }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: {{ section.settings.bg_color }};
  }

  /* Background image — covers full area */
  #about-hero-{{ section.id }} .about-hero__img {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #about-hero-{{ section.id }} .about-hero__img img,
  #about-hero-{{ section.id }} .about-hero__img svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  /* Optional overlay ON TOP of image */
  #about-hero-{{ section.id }} .about-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    display: none;
  }

  {% if section.settings.enable_overlay %}
  #about-hero-{{ section.id }} .about-hero__overlay {
    display: block;
    {% if section.settings.overlay_direction == 'to_right' %}
      background: linear-gradient(
        to right,
        {{ section.settings.overlay_color }} 0%,
        {{ section.settings.overlay_color }}DD 20%,
        {{ section.settings.overlay_color }}88 45%,
        {{ section.settings.overlay_color }}22 70%,
        transparent 100%
      );
    {% elsif section.settings.overlay_direction == 'to_bottom' %}
      background: linear-gradient(
        to bottom,
        transparent 0%,
        {{ section.settings.overlay_color }}CC 100%
      );
    {% else %}
      background-color: {{ section.settings.overlay_color }};
      opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {% endif %}
  }
  {% endif %}

  /* Content — positioned over image */
  #about-hero-{{ section.id }} .about-hero__content {
    position: relative;
    z-index: 2;
    padding: 64px 80px;
    width: 100%;
    max-width: 580px;

    {% if section.settings.text_alignment == 'center' %}
      margin: 0 auto;
      text-align: center;
    {% elsif section.settings.text_alignment == 'right' %}
      margin-left: auto;
      margin-right: 80px;
      text-align: right;
    {% else %}
      text-align: left;
    {% endif %}
  }

  /* Badge — plain small uppercase text, no pill background */
  #about-hero-{{ section.id }} .about-hero__badge {
    display: block;
    font-family: var(--primary-font);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.badge_color }};
    margin-bottom: 16px;
    line-height: 1;
  }

  /* Heading */
  #about-hero-{{ section.id }} .about-hero__heading {
    font-family: var(--primary-font);
    font-size: clamp(36px, 5vw, {{ section.settings.heading_size }}px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: {{ section.settings.heading_color }};
    margin: 0 0 24px;
  }

  /* Description */
  #about-hero-{{ section.id }} .about-hero__desc {
    font-family: var(--primary-font);
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    margin: 0 0 36px;
    max-width: 440px;
    {% if section.settings.text_alignment == 'center' %}margin-inline: auto;{% endif %}
  }

  /* Button — solid rounded pill */
  #about-hero-{{ section.id }} .about-hero__btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 32px;
    font-family: var(--primary-font);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    background-color: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    border: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
    line-height: 1;
  }

  #about-hero-{{ section.id }} .about-hero__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  /* ── TABLET ── */
  @media screen and (max-width: 1023px) {
    #about-hero-{{ section.id }} .about-hero__content {
      padding: 48px 48px;
      max-width: 520px;
    }
  }

  /* ── MOBILE ── */
  @media screen and (max-width: 749px) {
    #about-hero-{{ section.id }} .about-hero__wrap {
      min-height: {{ section.settings.mobile_height }}px;
    }

    #about-hero-{{ section.id }} .about-hero__content {
      padding: 36px 24px;
      max-width: 100%;
      text-align: left;
    }

    #about-hero-{{ section.id }} .about-hero__desc {
      max-width: 100%;
    }

    /* On mobile always use bottom-to-top gradient so text is readable */
    {% if section.settings.enable_overlay %}
    #about-hero-{{ section.id }} .about-hero__overlay {
      background: linear-gradient(
        to top,
        {{ section.settings.overlay_color }}EE 0%,
        {{ section.settings.overlay_color }}BB 40%,
        {{ section.settings.overlay_color }}55 70%,
        transparent 100%
      ) !important;
    }
    {% else %}
    #about-hero-{{ section.id }} .about-hero__overlay {
      display: block;
      background: linear-gradient(
        to top,
        {{ section.settings.bg_color }}EE 0%,
        {{ section.settings.bg_color }}99 40%,
        transparent 80%
      );
    }
    {% endif %}

    /* Mobile: content at bottom */
    #about-hero-{{ section.id }} .about-hero__wrap {
      align-items: start;
    }

    #about-hero-{{ section.id }} .about-hero__heading {
      font-size: clamp(28px, 8vw, 40px);
    }

    #about-hero-{{ section.id }} .about-hero__btn {
      padding: 13px 28px;
      font-size: 14px;
    }

    /* Mobile-specific image if set */
    #about-hero-{{ section.id }} .about-hero__img--desktop {
      {% if section.settings.image_mobile != blank %}
        display: none;
      {% endif %}
    }

    #about-hero-{{ section.id }} .about-hero__img--mobile {
      display: block;
    }
  }

  @media screen and (min-width: 750px) {
    #about-hero-{{ section.id }} .about-hero__img--mobile {
      display: none;
    }

    #about-hero-{{ section.id }} .about-hero__img--desktop {
      display: block;
    }
  }
</style>

<div class="about-hero-section" id="about-hero-{{ section.id }}">
  <div class="about-hero__wrap">
    {%- comment -%} Desktop background image {%- endcomment -%}
    <div class="about-hero__img about-hero__img--desktop" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        <img
          srcset="
            {{ section.settings.image | image_url: width: 800 }} 800w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w,
            {{ section.settings.image | image_url: width: 1600 }} 1600w,
            {{ section.settings.image | image_url: width: 2200 }} 2200w
          "
          sizes="100vw"
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          loading="eager"
          fetchpriority="high"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    {%- comment -%} Mobile background image (optional) {%- endcomment -%}
    {%- if section.settings.image_mobile != blank -%}
      <div class="about-hero__img about-hero__img--mobile" aria-hidden="true">
        <img
          src="{{ section.settings.image_mobile | image_url: width: 800 }}"
          srcset="
            {{ section.settings.image_mobile | image_url: width: 600 }} 600w,
            {{ section.settings.image_mobile | image_url: width: 800 }} 800w
          "
          sizes="100vw"
          alt="{{ section.settings.image_mobile.alt | default: section.settings.heading | escape }}"
          loading="eager"
          width="{{ section.settings.image_mobile.width }}"
          height="{{ section.settings.image_mobile.height }}"
        >
      </div>
    {%- endif -%}

    {%- comment -%} Colour overlay {%- endcomment -%}
    <div class="about-hero__overlay" aria-hidden="true"></div>

    {%- comment -%} Text content {%- endcomment -%}
    <div class="about-hero__content">
      {%- if section.settings.badge_text != blank -%}
        <span class="about-hero__badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="about-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="about-hero__desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="about-hero__btn"
        >
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Hero",
  "tag": "section",
  "class": "section-about-hero",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image (Desktop)",
      "info": "Recommended: 2200 x 900px. Image fills full width edge to edge."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background Image (Mobile)",
      "info": "Optional. If left blank, desktop image is used on mobile too."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "info": "Shows while image loads and on sides if image is narrower than screen.",
      "default": "#FFE8DD"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable Color Overlay",
      "default": true,
      "info": "Adds a colour wash over the image to make text readable."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#FFE8DD"
    },
    {
      "type": "select",
      "id": "overlay_direction",
      "label": "Overlay Direction",
      "options": [
        { "value": "to_right", "label": "Left fade (recommended)" },
        { "value": "to_bottom", "label": "Bottom fade" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "to_right"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity (solid only)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "About Us"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#E8612C"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the moments that make you, you."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 32,
      "max": 88,
      "step": 4,
      "unit": "px",
      "label": "Heading Size (desktop max)",
      "default": 64
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0E5C66"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Uniquely You was created to celebrate individuality through custom apparel that speaks your story. We believe what you wear should feel like you—authentic, meaningful, and effortlessly you."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#E8612C"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Alignment"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Desktop Min Height",
      "default": 480
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Mobile Min Height",
      "default": 500
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}
