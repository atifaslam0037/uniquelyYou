{% comment %}
  About Values Section
  Centered heading + 4-column icon grid — matches "What We Stand For" reference
{% endcomment %}

<style>
  /* ================================================================
     ABOUT VALUES SECTION
  ================================================================ */

  #about-values-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    font-family: var(--primary-font, sans-serif);
  }

  #about-values-{{ section.id }} .av__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Section heading ── */
  #about-values-{{ section.id }} .av__heading-wrap {
    text-align: center;
    margin-bottom: 52px;
  }

  #about-values-{{ section.id }} .av__heading {
    font-family: var(--primary-font, sans-serif);
    font-size: clamp(26px, 3vw, {{ section.settings.heading_size }}px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  /* ── Grid ── */
  #about-values-{{ section.id }} .av__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: 0;
  }

  /* ── Single value card ── */
  #about-values-{{ section.id }} .av__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 32px;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
  }

  #about-values-{{ section.id }} .av__item:last-child {
    border-right: none;
  }

  /* ── Icon — no circle background, just the SVG ── */
  #about-values-{{ section.id }} .av__icon {
    padding: 16px;
    margin-bottom: 18px;
    flex-shrink: 0;
    border: 1px solid {{ section.settings.icon_color }};
    border-radius: 100%;
    color: {{ section.settings.icon_color }};
    stroke: {{ section.settings.icon_color }};
  }

  #about-values-{{ section.id }} .av__icon svg {
    width: 32px;
    height: 32px;
  }

  /* ── Title ── */
  #about-values-{{ section.id }} .av__title {
    font-family: var(--primary-font, sans-serif);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: {{ section.settings.title_color }};
    margin: 0 0 10px;
  }

  /* ── Description ── */
  #about-values-{{ section.id }} .av__desc {
    font-family: var(--primary-font, sans-serif);
    font-size: 13.5px;
    line-height: 1.65;
    color: {{ section.settings.text_color }};
    margin: 0;
    max-width: 200px;
  }

  /* ── Tablet ── */
  @media screen and (max-width: 1023px) {
    #about-values-{{ section.id }} .av__container {
      padding: 0 24px;
    }

    #about-values-{{ section.id }} .av__item {
      padding: 0 20px;
    }
  }

  /* ── Mobile: 2 columns ── */
  @media screen and (max-width: 749px) {
    #about-values-{{ section.id }} .av__container {
      padding: 0 20px;
    }

    #about-values-{{ section.id }} .av__heading-wrap {
      margin-bottom: 36px;
    }

    #about-values-{{ section.id }} .av__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 36px 16px;
    }

    #about-values-{{ section.id }} .av__item {
      padding: 0 8px;
      border-right: none;
    }

    #about-values-{{ section.id }} .av__desc {
      max-width: 100%;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    #about-values-{{ section.id }} .av__icon { transition: none; }
  }
</style>

<div id="about-values-{{ section.id }}">
  <div class="av__container">

    {%- comment -%} Section heading {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <div class="av__heading-wrap">
        <h2 class="av__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- comment -%} Values grid {%- endcomment -%}
    <div class="av__grid">
      {%- for block in section.blocks -%}
        <div class="av__item" {{ block.shopify_attributes }}>

          {%- comment -%} Icon {%- endcomment -%}
          <div class="av__icon">
            {%- case block.settings.icon -%}

              {%- when 'heart' -%}
                {%- comment -%} Be Uniquely You — heart {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>

              {%- when 'leaf' -%}
                {%- comment -%} Quality You Can Feel — leaf {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 22c1.25-1.25 2.5-2.5 3.5-4 1.5-2.4 2-5.5 2-7.5C7.5 5 11 2 16 2c2.5 0 5 .5 6 1.5C21 9 19 13.5 16 16c-2 1.5-5 2-7 2-1.5 0-3-.5-4-1L2 22z"/>
                  <line x1="12" y1="12" x2="2" y2="22"/>
                </svg>

              {%- when 'globe' -%}
                {%- comment -%} Made Responsibly — globe {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>

              {%- when 'users' -%}
                {%- comment -%} Community First — people/users {%- endcomment -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>

              {%- when 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>

              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>

              {%- when 'gift' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 12V22H4V12"/>
                  <path d="M22 7H2V12H22V7Z"/>
                  <path d="M12 22V7"/>
                  <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/>
                  <path d="M12 7H16.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
                </svg>

              {%- when 'award' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="6"/>
                  <path d="M8.21 13.89L7 23L12 20L17 23L15.79 13.88"/>
                </svg>

            {%- endcase -%}
          </div>

          {%- comment -%} Text {%- endcomment -%}
          {%- if block.settings.title != blank -%}
            <h3 class="av__title">{{ block.settings.title }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="av__desc">{{ block.settings.description }}</p>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "About Values",
  "tag": "section",
  "class": "section-about-values",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What We Stand For"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0E5C66"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#0E5C66"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heart",  "label": "Heart (Be Uniquely You)" },
            { "value": "leaf",   "label": "Leaf (Quality / Eco)" },
            { "value": "globe",  "label": "Globe (Made Responsibly)" },
            { "value": "users",  "label": "People (Community First)" },
            { "value": "star",   "label": "Star" },
            { "value": "shield", "label": "Shield Check" },
            { "value": "gift",   "label": "Gift" },
            { "value": "award",  "label": "Award / Ribbon" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Value Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A short description of this value and why it matters to us."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "heart",
            "title": "Be Uniquely You",
            "description": "We celebrate individuality and encourage you to embrace what makes you different."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "leaf",
            "title": "Quality You Can Feel",
            "description": "We use premium materials and print with care so your favorites last."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "globe",
            "title": "Made Responsibly",
            "description": "Sustainable production and thoughtful choices for a better tomorrow."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "users",
            "title": "Community First",
            "description": "We're here to inspire connection, positivity, and creativity in everything we do."
          }
        }
      ]
    }
  ]
}
{% endschema %}
