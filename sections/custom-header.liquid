{% liquid
  assign search_style = 'none'
  if section.settings.show_search
    render 'predictive-search-styles'
    render 'slideshow-styles'
    assign search_style = 'modal'
  endif

  assign sticky = false
  if section.settings.enable_sticky_header == 'always'
    assign sticky = 'always'
  elsif section.settings.enable_sticky_header == 'scroll-up'
    assign sticky = 'scroll-up'
  endif

  assign show_language = section.settings.show_language
  unless request.design_mode
    if localization.available_languages.size <= 1
      assign show_language = false
    endif
  endunless

  assign show_country = section.settings.show_country
  unless request.design_mode
    if localization.available_countries.size <= 1
      assign show_country = false
    endif
  endunless

  if request.design_mode
    if section.settings.show_country
      assign show_country = true
    endif
    if section.settings.show_language
      assign show_language = true
    endif
  endif

  assign show_localization = false
  if show_language or show_country
    assign show_localization = true
  endif

  assign is_transparent_home = false
  if section.settings.enable_transparent_home and request.page_type == 'index'
    assign is_transparent_home = true
  endif

  assign sidebar_menu = section.settings.menu
  assign shop_trigger_label = section.settings.shop_all_label
  if shop_trigger_label == blank and sidebar_menu != blank
    assign shop_trigger_label = sidebar_menu.title
  endif
  if shop_trigger_label == blank
    assign shop_trigger_label = 'Shop All'
  endif
%}

{%- comment -%} ── Structured Data ── {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- comment -%} ── Header Component ── {%- endcomment -%}
<header-component
  id="header-component"
  class="uly-header color-{{ section.settings.color_scheme }}{% if is_transparent_home %} uly-header--transparent{% endif %}{% if section.settings.sticky_style == 'glassmorphism' %} uly-header--glass{% endif %}"
  data-theme-color="rgb({{ section.settings.color_scheme.settings.background.rgb }})"
  data-sticky-style="{{ section.settings.sticky_style | default: 'glassmorphism' }}"
  {% if sticky %}sticky="{{ sticky }}"{% endif %}
  data-scroll-direction="none"
  data-skip-node-update
  style="
    --logo-max-width: {{ section.settings.logo_max_width | default: 160 }}px;
    --menu-image-border-radius: {{ section.settings.image_border_radius | default: 4 }}px;
  "
>
  {%- if request.page_type == 'index' -%}
    <h1 class="visually-hidden">{{ shop.name }}</h1>
  {%- endif -%}

  <div class="uly-header__underlay uly-header__underlay--closed"></div>
  <div class="uly-header__underlay uly-header__underlay--open"></div>

  <div class="uly-header__shell">

    {%- comment -%} ── TOP ROW: Logo | Search + Social + Localization + Actions ── {%- endcomment -%}
    <div class="uly-header__row color-{{ section.settings.color_scheme }} section section--full-width-margin" ref="headerRowTop">
      <div class="uly-header__inner spacing-style">

        {%- comment -%} LEFT: Logo only {%- endcomment -%}
        <div class="uly-header__col uly-header__col--left">
          <a href="{{ routes.root_url }}" class="uly-logo" aria-label="{{ shop.name }}">
            {%- assign logo_img = section.settings.logo_image | default: settings.logo -%}
            {%- if logo_img != blank -%}
              {{
                logo_img
                | image_url: width: section.settings.logo_max_width
                | image_tag:
                  class: 'uly-logo__img',
                  alt: logo_img.alt | default: shop.name,
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '120, 180, 240, 300',
                  sizes: '(max-width: 749px) 140px, 220px'
              }}
            {%- else -%}
              <span class="uly-logo__text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>

        {%- comment -%} RIGHT: Search → Social → Localization → Actions {%- endcomment -%}
        <div class="uly-header__col uly-header__col--right">

          {%- comment -%} 1. Search {%- endcomment -%}
          {% render 'header-inline-search', section: section %}

          {%- comment -%} 2. Social icons {%- endcomment -%}
          {% render 'header-social-icons', section: section %}

          {%- comment -%} 3. Localization — desktop only, hidden on mobile via CSS {%- endcomment -%}
          {%- if show_localization -%}
            <div class="uly-localization-slot uly-localization-slot--header">
              {% render 'uly-header-localization',
                section: section,
                show_country: show_country,
                show_language: show_language,
                id_suffix: ''
              %}
            </div>
          {%- endif -%}

          {%- comment -%} 4. Account + Cart {%- endcomment -%}
          <div class="uly-header-actions-wrapper{% if section.settings.show_account == false %} hide-account{% endif %}{% if section.settings.show_cart == false %} hide-cart{% endif %}">
            {% render 'header-actions',
              section: section,
              customer_account_menu: section.settings.customer_account_menu,
              display_style: section.settings.actions_display_style
            %}
          </div>

        </div>
      </div>
    </div>

    {%- comment -%} ── SHOP ALL BAR ── {%- endcomment -%}
    <div class="uly-header__bar section section--full-width-margin">

      <button
        type="button"
        id="uly-shop-drawer-trigger"
        class="uly-shop-bar__trigger"
        aria-expanded="false"
        aria-controls="uly-shop-sidebar"
      >
        <span class="uly-shop-bar__label">{{ shop_trigger_label | escape }}</span>
        <span class="uly-shop-bar__arrow" aria-hidden="true">&rsaquo;</span>
        {%- if section.settings.shop_all_suffix != blank -%}
          <span class="uly-shop-bar__suffix">{{ section.settings.shop_all_suffix | escape }}</span>
        {%- endif -%}
      </button>

      {%- comment -%}
        Mobile localization: only render if localization is enabled.
        Hidden on desktop via CSS.
      {%- endcomment -%}
      {%- if show_localization -%}
        <div class="uly-localization-slot uly-localization-slot--bar">
          {% render 'uly-header-localization',
            section: section,
            show_country: show_country,
            show_language: show_language,
            id_suffix: '-mobile'
          %}
        </div>
      {%- endif -%}
    </div>

    {% render 'uly-shop-sidebar',
      section: section,
      linklist: sidebar_menu,
      shop_label: shop_trigger_label
    %}

    {%- comment -%} Drawer host placeholder {%- endcomment -%}
    <div class="header__drawer uly-drawer-host" ref="headerDrawerContainer" data-skip-node-update="true" hidden aria-hidden="true"></div>

  </div>

  {%- comment -%} Satisfies header-component requiredRefs {%- endcomment -%}
  <div ref="headerMenu" class="uly-header-menu-placeholder" hidden aria-hidden="true"></div>
</header-component>

<script>
  (function () {
    'use strict';

    function initHeader() {
      var header = document.getElementById('header-component');
      if (!header) return;

      // Always force drawer mode — prevents Shopify's compiled CSS rule
      // #header-component[data-menu-style=menu] .header__drawer { display:none }
      header.dataset.menuStyle = 'drawer';

      // Scroll-based transparent header
      var isTransparent = header.classList.contains('uly-header--transparent');
      var THRESHOLD = 20;

      function onScroll() {
        if (window.scrollY > THRESHOLD) {
          header.setAttribute('data-scrolled', 'true');
        } else {
          header.removeAttribute('data-scrolled');
        }
      }

      if (isTransparent) {
        if (header._ulyScrollHandler) {
          window.removeEventListener('scroll', header._ulyScrollHandler);
        }
        header._ulyScrollHandler = onScroll;
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // Sync CSS height variables
      function syncHeights() {
        var headerGroup = document.getElementById('header-group');
        var row = header.querySelector('.uly-header__row');
        var bar = header.querySelector('.uly-header__bar');
        var rowH = row ? row.offsetHeight : 64;
        var barH = bar ? bar.offsetHeight : 40;
        var componentH = rowH + barH;
        var groupH = headerGroup ? headerGroup.offsetHeight : componentH;
        document.body.style.setProperty('--uly-shop-bar-height', barH + 'px');
        document.body.style.setProperty('--header-height', componentH + 'px');
        document.body.style.setProperty('--header-group-height', groupH + 'px');

        var barEl = header.querySelector('.uly-header__bar');
        if (barEl) {
          var sidebarTop = Math.round(barEl.getBoundingClientRect().bottom);
          document.documentElement.style.setProperty('--uly-sidebar-top', sidebarTop + 'px');
        }
      }

      syncHeights();
      window.addEventListener('resize', syncHeights);
      requestAnimationFrame(syncHeights);
      setTimeout(syncHeights, 300);

      if (typeof ResizeObserver !== 'undefined') {
        var ro = new ResizeObserver(syncHeights);
        var row = header.querySelector('.uly-header__row');
        var bar = header.querySelector('.uly-header__bar');
        if (row) ro.observe(row);
        if (bar) ro.observe(bar);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }

    document.addEventListener('shopify:section:load', function () {
      requestAnimationFrame(function () {
        requestAnimationFrame(initHeader);
      });
    });

    document.addEventListener('shopify:block:select', function () {
      requestAnimationFrame(initHeader);
    });
  })();
</script>

<script src="{{ 'uly-shop-drawer.js' | asset_url }}" type="module"></script>
<script src="{{ 'header.js' | asset_url }}" type="module"></script>
{{ 'custom-header.css' | asset_url | stylesheet_tag }}
{{ 'uly-shop-sidebar.css' | asset_url | stylesheet_tag }}

{% stylesheet %}
  /* ── Admin editor critical overrides ── */

  body {
    --header-height: 104px;
    --uly-shop-bar-height: 40px;
    --header-row-height: 64px;
    --header-group-height: 104px;
    --transparent-header-offset-boolean: 0;
  }

  #header-group:has(#header-component[sticky]) {
    display: contents;
  }

  .header-section:has(.uly-header--transparent) {
    height: 0;
    min-height: 0;
    overflow: visible;
  }

  .uly-header .header__drawer.uly-drawer-host {
    display: none !important;
    min-height: 0 !important;
    pointer-events: none;
  }

  .uly-header-menu-placeholder { display: none !important; }

  .uly-header {
    --header-padding: 0 var(--padding-lg);
    display: block;
    background: transparent;
    font-family: var(--primary-font, sans-serif);
  }

  .uly-header__shell { position: relative; }

  .header-section:has(> #header-component[sticky='always']),
  .header-section:has(> #header-component[sticky='scroll-up'][data-sticky-state='active']) {
    position: sticky;
    top: -1px;
    z-index: var(--layer-sticky);
  }

  .uly-header__underlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .uly-header__underlay--closed {
    height: 100%;
    z-index: var(--layer-lowest);
    background: var(--color-background);
  }
  .uly-header__underlay--open { height: 0; display: none; }

  .uly-header__row {
    position: relative;
    background-color: transparent;
    border-block: 1px solid rgba(var(--color-foreground-rgb), 0.85);
    background-color: var(--color-background);
  }

  .uly-header__inner {
    display: grid;
    grid-template-columns: minmax(100px, auto) minmax(0, 1fr);
    align-items: center;
    min-height: var(--header-row-height, 64px);
    padding: 0.5rem var(--padding-lg, 1.5rem);
    gap: var(--gap-md, 1rem);
  }

  .uly-header__col {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 0.5rem);
  }
  .uly-header__col--left { justify-content: flex-start; }
  .uly-header__col--right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: nowrap;
    gap: 0.5rem;
    min-width: 0;
  }

  .uly-header__col--right > * {
    flex-shrink: 0;
  }

  .uly-localization-slot--header {
    order: 3;
    margin-inline: 0.15rem;
  }

  .uly-header-actions-wrapper {
    order: 4;
  }

  /* Beat Shopify's compiled rule that hides .header__drawer when data-menu-style=menu */
  #header-component.uly-header .header__drawer,
  #header-component.uly-header[data-menu-style] .header__drawer,
  #header-component.uly-header[data-menu-style='menu'] .header__drawer,
  #header-component.uly-header[data-menu-style='drawer'] .header__drawer {
    display: block !important;
    visibility: visible !important;
    min-height: 0 !important;
  }

  #header-component .header-menu,
  #header-component header-menu { display: none !important; }

  .uly-header--transparent:not([data-scrolled='true']) .uly-header__row {
    background-color: transparent !important;
    border-block-color: rgba(255,255,255,0.35) !important;
  }

  /* SHOP ALL BAR — padding matches .uly-header__inner so trigger lines up with logo */
  .uly-header__bar {
    position: relative;
    z-index: calc(var(--layer-sticky, 200) + 1);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
    min-height: var(--uly-shop-bar-height, 40px);
    padding: 0.35rem var(--padding-lg, 1.5rem);
    /* IMPORTANT: must be auto — pointer-events:none was blocking trigger clicks */
    pointer-events: auto;
  }

  @media screen and (max-width: 749px) {
    .uly-header__bar {
      justify-content: space-between;
      padding: 0.35rem 1rem;
    }
  }

  .uly-localization-slot {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    pointer-events: auto;
  }

  /* Localization slot visibility */
  .uly-localization-slot--bar { display: none !important; }
  .uly-localization-slot--header { display: flex; }

  .uly-shop-bar__trigger {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: var(--primary-font, sans-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .uly-header--transparent:not([data-scrolled='true']) .uly-shop-bar__trigger {
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .uly-header:not(.uly-header--transparent) .uly-shop-bar__trigger,
  .uly-header--transparent[data-scrolled='true'] .uly-shop-bar__trigger {
    color: var(--primary-accent, #0e5c66);
    text-shadow: none;
  }

  .uly-shop-bar__trigger:hover { opacity: 0.85; }

  /* LOGO */
  .uly-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-foreground);
    max-height: calc(var(--header-row-height, 64px) - 12px);
    transition: opacity 0.2s ease;
  }
  .uly-logo:hover { opacity: 0.8; }
  .uly-logo__img {
    display: block;
    width: auto;
    height: 100%;
    max-width: var(--logo-max-width, 120px);
    max-height: calc(var(--header-row-height, 64px) - 12px);
    object-fit: contain;
  }
  .uly-logo__text {
    font-family: var(--primary-font, sans-serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  /* Localization dropdown button */
  dropdown-localization-component.uly-localization {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  #header-component.uly-header dropdown-localization-component.uly-localization.dropdown-localization,
  #header-component.uly-header .uly-localization-slot .dropdown-localization {
    display: inline-flex !important;
  }

  .uly-localization .dropdown-localization__button {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--primary-font, sans-serif);
    font-size: 13px;
    font-weight: 500;
    padding: 4px 6px;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: 6px;
    cursor: pointer;
    color: var(--color-foreground);
    white-space: nowrap;
    min-height: 40px;
    transition: background-color 0.2s ease;
  }
  .uly-localization .dropdown-localization__button:hover {
    background: rgba(var(--color-foreground-rgb), 0.06) !important;
  }
  .uly-localization .localization-wrapper {
    position: absolute !important;
    top: calc(100% + 6px) !important;
    right: 0 !important;
    left: auto !important;
    width: 260px !important;
    max-height: 360px !important;
    overflow-y: auto !important;
    border-radius: 10px !important;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.1) !important;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15) !important;
    background-color: var(--color-background) !important;
    z-index: 9999 !important;
  }

  /* Admin editor: always show localization in header row, never in bar */
  .shopify-design-mode .uly-localization-slot--header { display: flex !important; }
  .shopify-design-mode .uly-localization-slot--bar    { display: none !important; }

  /* Mobile */
  @media screen and (max-width: 749px) {
    body {
      --header-height: 56px;
      --uly-shop-bar-height: 40px;
    }
    .uly-header__inner {
      grid-template-columns: auto 1fr;
      padding: 0.35rem 1rem;
      gap: 0.35rem;
    }
    .uly-header__col--right { gap: 0.15rem; }
    .uly-localization-slot--header { display: none !important; }
    .uly-localization-slot--bar { display: flex !important; }
    .uly-header__bar { padding: 0.35rem 1rem; }
  }

  /* Desktop */
  @media screen and (min-width: 750px) {
    .uly-localization-slot--header { display: flex !important; }
    .uly-localization-slot--bar { display: none !important; }
  }
{% endstylesheet %}

{% unless request.design_mode %}
  <script type="module">
    import { hydrate } from '@theme/section-hydration';
    const url = new URL(window.location.href);
    url.searchParams.delete('page');
    hydrate('{{ section.id }}', url);
  </script>
{% endunless %}

{% schema %}
{
  "name": "Custom Header",
  "tag": "header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Overrides the global logo setting."
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Sidebar menu",
      "default": "main-menu",
      "info": "Use your Shop All navigation menu (handle: shop-all). Nested links appear in the sidebar."
    },
    {
      "type": "url",
      "id": "shop_all_collections_url",
      "label": "Shop All collections link",
      "info": "Top link in the sidebar (e.g. all collections page). Leave blank for /collections."
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop button label",
      "info": "Leave blank to use the navigation menu title.",
      "default": "Shop All"
    },
    {
      "type": "text",
      "id": "shop_all_suffix",
      "label": "Shop button suffix",
      "info": "Optional text after the arrow, e.g. Collections:",
      "default": "Collections:"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search_placeholder",
      "label": "Show search placeholder text",
      "default": false,
      "visible_if": "{{ section.settings.show_search }}"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder text",
      "default": "Find what makes you unique!",
      "visible_if": "{{ section.settings.show_search and section.settings.show_search_placeholder }}"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "header",
      "content": "Language & Currency"
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Show country/currency selector",
      "default": true,
      "info": "Requires multiple markets in Shopify Markets. Always visible in the theme editor when enabled."
    },
    {
      "type": "checkbox",
      "id": "country_selector_style",
      "label": "Show country flag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Action Icons"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Sidebar Menu Options"
    },
    {
      "type": "checkbox",
      "id": "drawer_accordion",
