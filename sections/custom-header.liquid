{% liquid
  assign search_style = 'none'
  if section.settings.show_search
    render 'predictive-search-styles'
    render 'slideshow-styles'
    assign search_style = 'modal'
  endif

  assign sticky = false
  if section.settings.enable_sticky_header == 'always'
    assign sticky = 'always'
  elsif section.settings.enable_sticky_header == 'scroll-up'
    assign sticky = 'scroll-up'
  endif

  assign show_language = section.settings.show_language
  if localization.available_languages.size <= 1
    assign show_language = false
  endif

  assign show_country = section.settings.show_country
  if localization.available_countries.size <= 1
    assign show_country = false
  endif

  assign is_transparent_home = false
  if section.settings.enable_transparent_home and request.page_type == 'index'
    assign is_transparent_home = true
  endif
%}

{%- comment -%} ── Logo ── {%- endcomment -%}
{% capture logo %}
  <a href="{{ routes.root_url }}" class="uly-logo" aria-label="{{ shop.name }}">
    {%- assign logo_img = section.settings.logo_image | default: settings.logo -%}
    {%- if logo_img -%}
      {%- assign logo_alt = logo_img.alt | default: shop.name -%}
      {{
        logo_img
        | image_url: width: section.settings.logo_max_width
        | image_tag:
          class: 'uly-logo__img',
          alt: logo_alt,
          loading: 'eager',
          fetchpriority: 'high',
          widths: '120, 180, 240, 300',
          sizes: '(max-width: 749px) 140px, 220px'
      }}
    {%- else -%}
      <span class="uly-logo__text">{{ shop.name }}</span>
    {%- endif -%}
  </a>
{% endcapture %}

{%- comment -%} ── Search (native Horizon modal trigger) ── {%- endcomment -%}
{% capture search_markup %}
  {% render 'search', style: search_style, display_style: section.settings.actions_display_style %}
{% endcapture %}

{%- comment -%} ── Cart + Account (native Horizon cart drawer + custom account link) ── {%- endcomment -%}
{% capture actions_markup %}
  <div class="uly-header-actions-wrapper{% if section.settings.show_account == false %} hide-account{% endif %}{% if section.settings.show_cart == false %} hide-cart{% endif %}">
    {% if shop.customer_accounts_enabled and section.settings.show_account %}
      <a href="{{ routes.account_url }}" class="uly-account-link header-actions__action focus-inset" aria-label="{{ 'customer.account_fallback' | t | default: 'Account' }}">
        <span class="svg-wrapper"></span>
      </a>
    {% endif %}
    {% render 'header-actions',
      section: section,
      customer_account_menu: section.settings.customer_account_menu,
      display_style: section.settings.actions_display_style
    %}
  </div>
{% endcapture %}

{%- comment -%} ── Avera-style Localization (flag + ISO code dropdown) ── {%- endcomment -%}
{% capture localization_markup %}
  {% liquid
    assign localization_font = '--menu-localization-font: var(--primary-font); '
    assign localization_font_size = '--menu-localization-font-size: 0.875rem; '
    assign color_shadow = '--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));'
    assign form_style = localization_font | append: localization_font_size | append: color_shadow
  %}
  {% if show_language and show_country == false %}
    <div class="uly-localization">
      {% render 'localization-form',
        show_country: show_country,
        show_language: show_language,
        localization_style: 'dropdown',
        form_style: form_style,
        form_id: section.id
      %}
    </div>
  {% elsif show_country %}
    <dropdown-localization-component class="uly-localization dropdown-localization">
      <button
        type="button"
        class="button uly-localization__btn dropdown-localization__button localization-selector header-actions__action"
        aria-expanded="false"
        aria-controls="uly-localization-results"
        ref="button"
        on:click="/toggleSelector"
        style="{{ form_style }}"
      >
        {%- if show_country -%}
          {%- if section.settings.country_selector_style -%}
            {% liquid
              assign bg_brightness = section.settings.color_scheme.settings.background | color_brightness
              if bg_brightness < 64
                assign shadow_size = 4
              else
                assign shadow_size = 2
              endif
            %}
            <span
              class="icon-flag"
              style="
                background-image: url({{ localization.country | image_url: width: 32 }});
                --size-shadow: {{ shadow_size }}px;
                --color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-30-60));
              "
            ></span>
          {%- endif -%}
          <span class="currency-code" data-testid="localization-currency-code">
            {{- localization.country.currency.iso_code -}}
          </span>
        {%- endif -%}

        <span class="visually-hidden">
          {{- 'accessibility.localization_region_and_language' | t -}}
        </span>

        {%- if show_country and show_language -%}
          <span>/</span>
        {%- endif -%}

        {%- if show_language -%}
          <span>{{ localization.language.iso_code | upcase }}</span>
        {%- endif -%}

        <span class="svg-wrapper icon-caret">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      <div
        id="uly-localization-results"
        class="localization-wrapper right-bound color-{{ settings.popover_color_scheme }}"
        hidden
        ref="panel"
      >
        {% render 'localization-form',
          show_country: show_country,
          show_language: show_language,
          localization_style: 'dropdown',
          form_style: form_style,
          form_id: section.id
        %}
      </div>
    </dropdown-localization-component>
  {% endif %}
{% endcapture %}

{%- comment -%} ── Structured Data ── {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- comment -%} ── Header Component ── {%- endcomment -%}
<header-component
  id="header-component"
  class="uly-header color-{{ section.settings.color_scheme }}{% if is_transparent_home %} uly-header--transparent{% endif %}"
  data-theme-color="rgb({{ section.settings.color_scheme.settings.background.rgb }})"
  {% if sticky %}
    sticky="{{ sticky }}"
  {% endif %}
  data-scroll-direction="none"
  data-skip-node-update
  style="
    --color-scheme-top-row: rgba({{ section.settings.color_scheme.settings.background.rgba }});
    --color-scheme-bottom-row: rgba({{ section.settings.color_scheme.settings.background.rgba }});
    --logo-max-width: {{ section.settings.logo_max_width | default: 160 }}px;
    --menu-image-border-radius: {{ section.settings.image_border_radius | default: 4 }}px;
  "
>
  {%- if request.page_type == 'index' -%}
    <h1 class="visually-hidden">{{ shop.name }}</h1>
  {%- endif -%}

  <div class="uly-header__underlay uly-header__underlay--closed"></div>
  <div class="uly-header__underlay uly-header__underlay--open"></div>

  <div class="uly-header__row color-{{ section.settings.color_scheme }} section section--full-width-margin">
    <div class="uly-header__inner spacing-style">
      {%- comment -%} LEFT COLUMN — Hamburger + Search + Desktop Menu {%- endcomment -%}
      <div class="uly-header__col uly-header__col--left">
        {% render 'header-drawer',
          linklist: section.settings.menu,
          desktop_menu: section.settings.desktop_menu,
          section: section,
          block: section,
          data_header_drawer_type: 'mobile-drawer'
        %}
        {{ search_markup }}
        {%- if section.settings.desktop_menu != blank -%}
          <nav class="uly-header__inline-menu desktop:visible mobile:hidden">
            <ul class="uly-list-menu list-unstyled" role="list">
              {%- for link in section.settings.desktop_menu.links -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="uly-list-menu__item focus-inset{% if link.current %} uly-list-menu__item--active{% endif %}"
                  >
                    <span>{{ link.title | escape }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>

      {%- comment -%} CENTER COLUMN — Logo {%- endcomment -%}
      <div class="uly-header__col uly-header__col--center">
        {{ logo }}
      </div>

      {%- comment -%} RIGHT COLUMN — Account, Cart, Localization {%- endcomment -%}
      <div class="uly-header__col uly-header__col--right">
        {{ localization_markup }}
        {{ actions_markup }}
      </div>
    </div>
  </div>
</header-component>

{%- comment -%} ── Force sidebar mode on ALL devices (override theme.liquid inline script) ── {%- endcomment -%}
<script>
  (function overrideMenuStyle() {
    const header = document.querySelector('#header-component');
    if (header) {
      header.dataset.menuStyle = 'drawer';
    }
  })();
</script>

<script src="{{ 'header.js' | asset_url }}" type="module"></script>
{{ 'custom-header.css' | asset_url | stylesheet_tag }}

{% stylesheet %}
  /* ============================================================
     ULY CUSTOM HEADER — Base structural styles
     All design tokens sourced from global-variables.css
  ============================================================ */

  body {
    --header-height: 64px;
    --header-group-height: var(--header-height);
    --transparent-header-offset-boolean: 0;
  }

  .uly-header {
    --header-padding: 0 var(--padding-lg);
    --header-content-transition-timing: 0s;

    display: block;
    contain: layout style;
    background: transparent;
    font-family: var(--primary-font, sans-serif);
  }

  /* ── Sticky ── */
  .header-section:has(> #header-component[sticky='always']),
  .header-section:has(> #header-component[sticky='scroll-up'][data-sticky-state='active']) {
    position: sticky;
    top: -1px;
    z-index: var(--layer-sticky);
  }

  .uly-header[data-sticky-state] {
    transition: opacity var(--animation-speed) var(--animation-easing);
    opacity: 1;
  }

  .uly-header[data-sticky-state='idle'] {
    opacity: 0;
  }

  /* ── Underlays (background) ── */
  .uly-header__underlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .uly-header__underlay--closed {
    height: 100%;
    z-index: var(--layer-lowest);
    background: var(--color-scheme-top-row);
    transition: height var(--animation-speed-slow) var(--ease-out-cubic);
  }

  .uly-header__underlay--open {
    height: var(--full-open-header-height, 0px);
    background: var(--color-scheme-top-row);
    transition: height var(--submenu-animation-speed, 0.3s) var(--ease-out-cubic);
  }

  /* ── Row ── */
  .uly-header__row {
    position: relative;
    background-color: transparent;
  }

  /* ── Inner grid ── */
  .uly-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'left center right';
    align-items: center;
    height: var(--header-height);
    padding: var(--header-padding);
    gap: var(--gap-lg, 1.5rem);
  }

  /* ── Columns ── */
  .uly-header__col {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 0.5rem);
  }

  .uly-header__col--left {
    grid-area: left;
  }
  .uly-header__col--center {
    grid-area: center;
    justify-content: center;
  }
  .uly-header__col--right {
    grid-area: right;
    justify-content: flex-end;
  }

  /* ── Localization button (Avera style) ── */
  .uly-localization .dropdown-localization__button {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--primary-font, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    padding-inline: var(--padding-2xs);
    background: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
    cursor: pointer;
    color: var(--color-foreground);
    letter-spacing: 0.02em;
    transition: opacity 0.2s ease;
  }

  .uly-localization .dropdown-localization__button:hover {
    opacity: 0.75;
  }

  .uly-localization .icon-flag {
    width: 18px;
    height: 18px;
    clip-path: circle(50%);
    background-position: center;
    background-size: cover;
    margin-inline-end: 2px;
    position: relative;
    flex-shrink: 0;
  }

  .uly-localization .icon-caret {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .uly-localization .dropdown-localization__button[aria-expanded='true'] .icon-caret svg {
    transform: rotate(180deg);
  }

  /* ── Logo ── */
  .uly-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .uly-logo__img {
    height: auto;
    max-width: var(--logo-max-width, 160px);
    display: block;
  }

  .uly-logo__text {
    font-family: var(--primary-font, sans-serif);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  /* ── Action icons (search/cart) ── */
  .uly-header__col--right .header-actions__action {
    color: var(--color-foreground);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .uly-header__col--right .header-actions__action:hover {
    opacity: 0.7;
  }

  /* ── Hamburger button ── */
  .uly-header__col--left .menu-drawer-container .header__icon--summary {
    color: var(--color-foreground);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--padding-sm, 0.5rem);
    cursor: pointer;
  }

  /* ── Force drawer on all screen sizes ── */
  #header-component .header-menu,
  #header-component header-menu,
  #header-component .dropdown-localization.mobile\:hidden {
    display: flex !important;
  }

  /* ── Mobile adjustments ── */
  @media screen and (max-width: 749px) {
    body {
      --header-height: 56px;
    }

    .uly-header__inner {
      gap: var(--gap-xs, 0.25rem);
      padding: 0 var(--padding-sm);
    }

    .uly-logo__img {
      max-width: 130px;
    }
  }
{% endstylesheet %}

{% unless request.design_mode %}
  <script type="module">
    import { hydrate } from '@theme/section-hydration';
    const url = new URL(window.location.href);
    url.searchParams.delete('page');
    hydrate('{{ section.id }}', url);
  </script>
{% endunless %}

{% schema %}
{
  "name": "Custom Header",
  "tag": "header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Custom logo image",
      "info": "Overrides the global logo setting."
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Sidebar Menu",
      "default": "main-menu",
      "info": "This menu appears inside the hamburger drawer."
    },
    {
      "type": "link_list",
      "id": "desktop_menu",
      "label": "Desktop Horizontal Menu",
      "info": "This menu appears horizontally on desktop devices."
    },
    {
      "type": "header",
      "content": "Customer Account"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Language & Currency"
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Show country/currency selector",
      "info": "Manage countries in your Shopify Markets settings.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "country_selector_style",
      "label": "Show country flag",
      "default": true,
      "visible_if": "{{ section.settings.show_country }}"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Show language selector",
      "info": "Manage languages in your Shopify Language settings.",
      "default": true
    },
    {
      "type": "header",
      "content": "Sidebar Menu Options"
    },
    {
      "type": "checkbox",
      "id": "drawer_accordion",
      "label": "Accordion sub-menus",
      "info": "Expand/collapse sub-menu items in the sidebar.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "drawer_accordion_expand_first",
      "label": "Auto-expand first item",
      "default": false,
      "visible_if": "{{ section.settings.drawer_accordion }}"
    },
    {
      "type": "checkbox",
      "id": "drawer_dividers",
      "label": "Show dividers between items",
      "default": true
    },
    {
      "type": "select",
      "id": "menu_style",
      "label": "Sidebar menu style",
      "options": [
        { "value": "text", "label": "Text only" },
        { "value": "collection_images", "label": "Collection images" },
        { "value": "featured_collections", "label": "Featured collections" },
        { "value": "featured_products", "label": "Featured products" }
      ],
      "default": "text"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ section.settings.menu_style != 'text' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Sidebar color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_home",
      "label": "Enable transparent header on homepage",
      "default": true
    },
    {
      "type": "select",
      "id": "actions_display_style",
      "label": "Icons display style",
      "options": [
        { "value": "icon", "label": "Icons" },
        { "value": "text", "label": "Text" }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "enable_sticky_header",
      "label": "Sticky header",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "scroll-up", "label": "On scroll up" },
        { "value": "never", "label": "Never" }
      ],
      "default": "always"
    }
  ],
  "presets": []
}
{% endschema %}
