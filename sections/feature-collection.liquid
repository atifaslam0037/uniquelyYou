{% comment %}
  Collection Grid Section
  Displays collections in a responsive grid layout with image overlays
{% endcomment %}

<style>
  /* Collection Grid Section Styles */

  .collection-grid-wrapper {
    background-color: var(--white);
    overflow: hidden;
  }

  .page-width {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header Styles */
  .collection-grid-header {
    text-align: left;
    margin-bottom: 40px;
  }

  .collection-grid-eyebrow {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--secondary-accent);
    margin-bottom: 8px;
    font-family: var(--primary-font);
  }

  .collection-grid-heading {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    color: var(--black);
    margin-bottom: 12px;
    font-family: var(--primary-font);
  }

  .collection-grid-subheading {
    font-size: 16px;
    line-height: 1.6;
    color: #666;
    max-width: 600px;
    font-family: var(--primary-font);
  }

  /* Grid Layout - Featured Style */
  .collection-grid {
    display: grid;
    width: 100%;
  }

  /* Desktop Grid - Featured Layout (Balanced 2x2 Grid) */
  @media (min-width: 1024px) {
    .collection-grid[data-layout="featured"] {
      grid-template-columns: 1fr 0.5fr 0.5fr;
      grid-template-rows: 1fr 1fr;
    }

    /* First item - Left side, spans 2 rows */
    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(1) {
      grid-row: 1 / 3;
      grid-column: 1;
    }

    /* Second item - Top right first */
    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(2) {
      grid-row: 1;
      grid-column: 2;
    }

    /* Third item - Top right second */
    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(3) {
      grid-row: 1;
      grid-column: 3;
    }

    /* Fourth item - Bottom right, spans both columns */
    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(4) {
      grid-row: 2;
      grid-column: 2 / 4;
    }

    /* Regular Grid Layout */
    .collection-grid[data-layout="regular"][data-columns-desktop="2"] {
      grid-template-columns: repeat(2, 1fr);
    }

    .collection-grid[data-layout="regular"][data-columns-desktop="3"] {
      grid-template-columns: repeat(3, 1fr);
    }

    .collection-grid[data-layout="regular"][data-columns-desktop="4"] {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Tablet Grid */
  @media (min-width: 768px) and (max-width: 1023px) {
    .collection-grid[data-layout="featured"] {
      grid-template-columns: 1fr 0.5fr 0.5fr;
      grid-template-rows: 1fr 1fr;
    }

    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(1) {
      grid-row: 1 / 3;
      grid-column: 1;
    }

    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(2) {
      grid-row: 1;
      grid-column: 2;
    }

    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(3) {
      grid-row: 1;
      grid-column: 3;
    }

    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(4) {
      grid-row: 2;
      grid-column: 2 / 4;
    }

    .collection-grid[data-layout="regular"][data-columns-tablet="1"] {
      grid-template-columns: 1fr;
    }

    .collection-grid[data-layout="regular"][data-columns-tablet="2"] {
      grid-template-columns: repeat(2, 1fr);
    }

    .collection-grid[data-layout="regular"][data-columns-tablet="3"] {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Mobile Grid */
  @media (max-width: 767px) {
    .collection-grid[data-layout="featured"] {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    /* First item - Full width first row */
    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(1) {
      grid-column: 1 / 3;
      grid-row: auto;
    }

    /* Second item - Left in second row */
    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(2) {
      grid-column: 1;
      grid-row: auto;
    }

    /* Third item - Right in second row */
    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(3) {
      grid-column: 2;
      grid-row: auto;
    }

    /* Fourth item - Full width third row */
    .collection-grid[data-layout="featured"] .collection-grid-item:nth-child(4) {
      grid-column: 1 / 3;
      grid-row: auto;
    }

    .collection-grid[data-layout="regular"] {
      grid-template-columns: 1fr;
    }

    .collection-grid[data-columns-mobile="2"] {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Collection Grid Item */
  .collection-grid-item {
    position: relative;
    overflow: hidden;
    background-color: var(--background-soft);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    min-height: 0;
  }

  .collection-grid-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
  }

  .collection-grid-link {
    display: flex;
    flex-direction: column;
    position: relative;
    text-decoration: none;
    color: inherit;
    height: 100%;
    width: 100%;
  }

  .collection-grid-link[aria-disabled="true"] {
    cursor: default;
  }

  /* Image Wrapper */
  .collection-grid-image-wrapper {
    position: relative;
    width: 100%;
    flex: 1;
    overflow: hidden;
    min-height: 280px;
  }

  .collection-grid-image,
  .collection-grid-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collection-grid-item:hover .collection-grid-image {
    transform: scale(1.05);
  }

  .collection-grid-placeholder {
    background-color: var(--background-soft);
  }

  /* Overlay */
  .collection-grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(0, 0, 0, 0.1) 100%
    );
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .collection-grid-item:hover .collection-grid-overlay {
    opacity: 0.9;
  }

  /* Content */
  .collection-grid-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 24px;
    color: var(--white);
    z-index: 2;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collection-grid-item:hover .collection-grid-content {
    transform: translateY(-4px);
  }

  .collection-grid-count {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
    opacity: 0.9;
    font-family: var(--primary-font);
  }

  .collection-grid-title {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 12px;
    font-family: var(--primary-font);
    color: var(--white);
  }

  .collection-grid-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--white);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: var(--primary-font);
  }

  .collection-grid-item:hover .collection-grid-cta {
    opacity: 1;
    transform: translateX(0);
  }

  .collection-grid-cta svg {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collection-grid-item:hover .collection-grid-cta svg {
    transform: translateX(4px);
  }

  /* Tablet Responsive */
  @media (max-width: 1023px) {
    .page-width {
      padding: 0 16px;
    }

    .collection-grid-header {
      margin-bottom: 32px;
    }

    .collection-grid-image-wrapper {
      min-height: 250px;
    }

    .collection-grid-content {
      padding: 20px;
    }
  }

  /* Mobile Responsive */
  @media (max-width: 767px) {
    .page-width {
      padding: 0 16px;
    }

    .collection-grid-header {
      margin-bottom: 24px;
    }

    .collection-grid-eyebrow {
      font-size: 11px;
    }

    .collection-grid-subheading {
      font-size: 14px;
    }

    .collection-grid {
      gap: 16px;
    }

    .collection-grid-image-wrapper {
      min-height: 320px;
    }

    .collection-grid-content {
      padding: 16px;
    }

    .collection-grid-count {
      font-size: 10px;
      margin-bottom: 6px;
    }

    .collection-grid-title {
      margin-bottom: 8px;
    }

    .collection-grid-cta {
      font-size: 13px;
    }
  }

  /* Small Mobile (2 columns) */
  @media (max-width: 767px) {
    .collection-grid[data-columns-mobile="2"] .collection-grid-image-wrapper {
      min-height: 280px;
    }

    .collection-grid[data-columns-mobile="2"] .collection-grid-content {
      padding: 12px;
    }

    .collection-grid[data-columns-mobile="2"] .collection-grid-count {
      font-size: 9px;
    }

    .collection-grid[data-columns-mobile="2"] .collection-grid-title {
      font-size: 18px;
    }

    .collection-grid[data-columns-mobile="2"] .collection-grid-cta {
      font-size: 11px;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .collection-grid-item,
    .collection-grid-image,
    .collection-grid-overlay,
    .collection-grid-content,
    .collection-grid-cta,
    .collection-grid-cta svg {
      transition: none;
    }
  }

  /* Focus States */
  .collection-grid-link:focus {
    outline: 2px solid var(--primary-accent);
    outline-offset: 4px;
  }

  .collection-grid-link:focus:not(:focus-visible) {
    outline: none;
  }

  .collection-grid-link:focus-visible {
    outline: 2px solid var(--primary-accent);
    outline-offset: 4px;
  }

  /* Loading State */
  @media (prefers-reduced-motion: no-preference) {
    .collection-grid-image {
      animation: fadeIn 0.5s ease-in;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Print Styles */
  @media print {
    .collection-grid-overlay {
      display: none;
    }

    .collection-grid-item {
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }

  /* Section Padding */
  #collection-grid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<div class="collection-grid-wrapper" id="collection-grid-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="collection-grid-header">
        <p class="collection-grid-eyebrow">{{ section.settings.eyebrow_text }}</p>
        <h2 class="collection-grid-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="collection-grid-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="collection-grid"
      data-layout="{{ section.settings.grid_layout }}"
      data-columns-desktop="{{ section.settings.columns_desktop }}"
      data-columns-tablet="{{ section.settings.columns_tablet }}"
      data-columns-mobile="{{ section.settings.columns_mobile }}"
    >
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign placeholder_index = forloop.index | modulo: 6
          if placeholder_index == 0
            assign placeholder_index = 6
          endif
        %}

        <article
          class="collection-grid-item"
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <a
            href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
            class="collection-grid-link"
            {% if collection == blank %}
              aria-disabled="true"
            {% endif %}
            aria-label="{% if collection != blank %}Shop {{ collection.title }} collection{% else %}Collection placeholder{% endif %}"
          >
            <div class="collection-grid-image-wrapper">
              {% if collection != blank and collection.image != blank %}
                {% liquid
                  assign image = collection.image
                  assign image_alt = collection.image.alt | default: collection.title
                %}
                <img
                  srcset="
                    {{ image | image_url: width: 400 }} 400w,
                    {{ image | image_url: width: 600 }} 600w,
                    {{ image | image_url: width: 800 }} 800w,
                    {{ image | image_url: width: 1200 }} 1200w
                  "
                  sizes="
                    (min-width: 1200px) {{ 1200 | divided_by: section.settings.columns_desktop }}px,
                    (min-width: 768px) {{ 768 | divided_by: section.settings.columns_tablet }}px,
                    {{ 100 | divided_by: section.settings.columns_mobile }}vw
                  "
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image_alt }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="collection-grid-image"
                >
              {% elsif block.settings.custom_image != blank %}
                {% liquid
                  assign custom_image = block.settings.custom_image
                  assign custom_alt = block.settings.custom_image.alt | default: block.settings.custom_title
                %}
                <img
                  srcset="
                    {{ custom_image | image_url: width: 400 }} 400w,
                    {{ custom_image | image_url: width: 600 }} 600w,
                    {{ custom_image | image_url: width: 800 }} 800w,
                    {{ custom_image | image_url: width: 1200 }} 1200w
                  "
                  sizes="
                    (min-width: 1200px) {{ 1200 | divided_by: section.settings.columns_desktop }}px,
                    (min-width: 768px) {{ 768 | divided_by: section.settings.columns_tablet }}px,
                    {{ 100 | divided_by: section.settings.columns_mobile }}vw
                  "
                  src="{{ custom_image | image_url: width: 800 }}"
                  alt="{{ custom_alt }}"
                  loading="lazy"
                  width="{{ custom_image.width }}"
                  height="{{ custom_image.height }}"
                  class="collection-grid-image"
                >
              {% else %}
                {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'collection-grid-placeholder' }}
              {% endif %}

              <div class="collection-grid-overlay"></div>
            </div>

            <div class="collection-grid-content">
              {% if block.settings.show_product_count %}
                <p class="collection-grid-count">
                  {% if collection != blank %}
                    {{ collection.products_count }}
                    {% if collection.products_count == 1 %}
                      DESIGN
                    {% else %}
                      DESIGNS
                    {% endif %}
                  {% else %}
                    42 DESIGNS
                  {% endif %}
                </p>
              {% endif %}

              <h3 class="collection-grid-title">
                {% if collection != blank %}
                  {{ collection.title }}
                {% elsif block.settings.custom_title != blank %}
                  {{ block.settings.custom_title }}
                {% else %}
                  Collection Name
                {% endif %}
              </h3>

              {% if section.settings.show_cta %}
                <span class="collection-grid-cta">
                  {{ section.settings.cta_text }}
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section-collection-grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "SHOP BY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One-liner collections"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Each collection tells a story. Pick the one that sounds the most like you."
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "grid_layout",
      "label": "Grid Layout Style",
      "options": [
        {
          "value": "featured",
          "label": "Featured (First item larger)"
        },
        {
          "value": "regular",
          "label": "Regular Grid"
        }
      ],
      "default": "featured",
      "info": "Featured layout makes the first collection larger, like the reference design"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap Between Items",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Corner Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on Tablet",
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Shop collection"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Optional)",
          "info": "Overrides collection featured image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (Optional)",
          "info": "Overrides collection title"
        },
        {
          "type": "checkbox",
          "id": "show_product_count",
          "label": "Show Product Count",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Grid",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  #collection-grid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #collection-grid-{{ section.id }} .collection-grid {
    gap: {{ section.settings.grid_gap }}px;
  }

  #collection-grid-{{ section.id }} .collection-grid-item {
    border-radius: {{ section.settings.border_radius }}px;
  }

  @media (max-width: 767px) {
    #collection-grid-{{ section.id }} .collection-grid[data-layout="featured"] {
      gap: {{ section.settings.grid_gap | divided_by: 1.25 }}px;
    }
  }
</style>
