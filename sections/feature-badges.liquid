{% comment %}
  Feature Badges Section
  Displays USPs with icons — styled to brand palette
{% endcomment %}

<style>
  .feature-badges-wrapper {
    background-color: var(--white);
    font-family: var(--primary-font);
    overflow: hidden;
  }

  .feature-badges-wrapper.has-borders {
    border-top: 1px solid rgba(14, 92, 102, 0.12);
    border-bottom: 1px solid rgba(14, 92, 102, 0.12);
  }

  .feature-badges-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .feature-badges-grid {
    display: grid;
    gap: 32px;
    width: 100%;
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .feature-badges-grid[data-columns-desktop="2"] { grid-template-columns: repeat(2, 1fr); max-width: 860px; margin: 0 auto; }
    .feature-badges-grid[data-columns-desktop="3"] { grid-template-columns: repeat(3, 1fr); max-width: 1060px; margin: 0 auto; }
    .feature-badges-grid[data-columns-desktop="4"] { grid-template-columns: repeat(4, 1fr); }
  }

  /* Tablet */
  @media (min-width: 768px) and (max-width: 1023px) {
    .feature-badges-grid[data-columns-tablet="2"] { grid-template-columns: repeat(2, 1fr); }
    .feature-badges-grid[data-columns-tablet="3"] { grid-template-columns: repeat(3, 1fr); }
    .feature-badges-grid[data-columns-tablet="4"] { grid-template-columns: repeat(4, 1fr); }
  }

  /* Badge item */
  .feature-badge-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  /* Icon circle — pale peach bg, teal icon */
  .feature-badge-icon-wrapper {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--background-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .feature-badge-item:hover .feature-badge-icon-wrapper {
    transform: scale(1.06);
    background-color: var(--color-pale-peach);
  }

  .feature-badge-icon {
    width: 22px;
    height: 22px;
    color: var(--primary-accent);
  }

  .feature-badge-content {
    flex: 1;
    min-width: 0;
    padding-top: 2px;
  }

  /* Orange accent rule above title */
  .feature-badge-rule {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--secondary-accent);
    opacity: 0.65;
    margin-bottom: 8px;
  }

  .feature-badge-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--black);
    margin: 0 0 4px;
    font-family: var(--primary-font);
  }

  .feature-badge-description {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(0, 0, 0, 0.5);
    margin: 0;
    font-family: var(--primary-font);
  }

  /* Tablet */
  @media (max-width: 1023px) {
    .feature-badges-container {
      padding: 0 32px;
    }
    .feature-badges-grid {
      gap: 24px;
    }
    .feature-badge-icon-wrapper {
      width: 44px;
      height: 44px;
    }
    .feature-badge-icon {
      width: 20px;
      height: 20px;
    }
    .feature-badge-title {
      font-size: 14px;
    }
    .feature-badge-description {
      font-size: 13px;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .feature-badges-container {
      padding: 0 20px;
    }
    .feature-badges-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 20px;
    }
    .feature-badge-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .feature-badge-icon-wrapper {
      width: 40px;
      height: 40px;
    }
    .feature-badge-icon {
      width: 18px;
      height: 18px;
    }
    .feature-badge-title {
      font-size: 13px;
    }
    .feature-badge-description {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-badge-icon-wrapper {
      transition: none;
    }
  }

  #feature-badges-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  #feature-badges-{{ section.id }} .feature-badges-grid {
    gap: {{ section.settings.grid_gap }}px;
  }

  @media (max-width: 767px) {
    #feature-badges-{{ section.id }} .feature-badges-grid {
      gap: {{ section.settings.grid_gap | divided_by: 1.5 | round }}px;
    }
  }
</style>

<div
  id="feature-badges-{{ section.id }}"
  class="feature-badges-wrapper{% if section.settings.show_borders %} has-borders{% endif %}"
>
  <div class="feature-badges-container">
    <div
      class="feature-badges-grid"
      data-columns-desktop="{{ section.settings.columns_desktop }}"
      data-columns-tablet="{{ section.settings.columns_tablet }}"
    >
      {% for block in section.blocks %}
        <div class="feature-badge-item" {{ block.shopify_attributes }}>

          <div class="feature-badge-icon-wrapper">
            {% case block.settings.icon %}
              {% when 'shipping' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 3H1V16H16V3Z"/>
                  <path d="M16 8H20L23 11V16H16V8Z"/>
                  <circle cx="5.5" cy="18.5" r="2.5"/>
                  <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
              {% when 'returns' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9L12 2L21 9V20C21 20.5 20.8 21 20.4 21.4C20 21.8 19.5 22 19 22H5C4.5 22 4 21.8 3.6 21.4C3.2 21 3 20.5 3 20V9Z"/>
                  <path d="M9 22V12H15V22"/>
                </svg>
              {% when 'print' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9V2H18V9"/>
                  <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
                  <rect x="6" y="14" width="12" height="8"/>
                </svg>
              {% when 'artwork' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L2 7L12 12L22 7L12 2Z"/>
                  <path d="M2 17L12 22L22 17"/>
                  <path d="M2 12L12 17L22 12"/>
                </svg>
              {% when 'check' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                  <path d="M22 4L12 14.01L9 11.01"/>
                </svg>
              {% when 'star' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                </svg>
              {% when 'gift' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 12V22H4V12"/>
                  <path d="M22 7H2V12H22V7Z"/>
                  <path d="M12 22V7"/>
                  <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/>
                  <path d="M12 7H16.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
                </svg>
              {% when 'shield' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            {% endcase %}
          </div>

          <div class="feature-badge-content">
            <span class="feature-badge-rule" aria-hidden="true"></span>
            {% if block.settings.title != blank %}
              <h3 class="feature-badge-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="feature-badge-description">{{ block.settings.description }}</p>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Badges",
  "tag": "section",
  "class": "section-feature-badges",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Tablet",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Gap Between Items",
      "default": 32
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show Top & Bottom Borders",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Feature Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping Truck" },
            { "value": "returns",  "label": "Returns / Home" },
            { "value": "print",    "label": "Print on Demand" },
            { "value": "artwork",  "label": "Artwork / Layers" },
            { "value": "check",    "label": "Check Mark" },
            { "value": "star",     "label": "Star" },
            { "value": "gift",     "label": "Gift" },
            { "value": "shield",   "label": "Shield / Security" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shipping", "title": "Free US shipping",    "description": "On all orders over $75" } },
        { "type": "badge", "settings": { "icon": "print",    "title": "Print-on-demand",     "description": "Made to order, less waste" } },
        { "type": "badge", "settings": { "icon": "star",     "title": "Original artwork",    "description": "Designs you won't see anywhere else" } },
        { "type": "badge", "settings": { "icon": "shield",   "title": "Easy returns",        "description": "30-day hassle-free returns" } }
      ]
    }
  ]
}
{% endschema %}
