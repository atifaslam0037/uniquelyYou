{% comment %}
  Feature Badges Section
  Horizontal strip with dividers — styled to match reference layout
{% endcomment %}

<style>
  .feature-badges-wrapper {
    background-color: var(--white, #ffffff);
    font-family: var(--primary-font, sans-serif);
    overflow: hidden;
  }

  .feature-badges-wrapper.has-borders {
    border-top: 1px solid rgba(14, 92, 102, 0.12);
    border-bottom: 1px solid rgba(14, 92, 102, 0.12);
  }

  .feature-badges-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
  }

  /* ── Horizontal strip grid ── */
  .feature-badges-grid {
    display: grid;
    grid-template-columns: repeat(var(--badge-count, 4), 1fr);
    width: 100%;
    align-items: center;
  }

  /* Vertical divider between items (CSS-only via border-right) */
  .feature-badge-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 32px;
    border-right: 1px solid rgba(14, 92, 102, 0.13);
  }

  .feature-badge-item:first-child {
    padding-left: 0;
  }

  .feature-badge-item:last-child {
    border-right: none;
    padding-right: 0;
  }

  /* ── Icon circle ── */
  .feature-badge-icon-wrapper {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
  }

  /* Alternating palette: peach / teal / peach / teal … */
  .feature-badge-item:nth-child(odd)  .feature-badge-icon-wrapper { background-color: #fce8df; }
  .feature-badge-item:nth-child(even) .feature-badge-icon-wrapper { background-color: #d4ecea; }

  .feature-badge-item:hover .feature-badge-icon-wrapper {
    transform: scale(1.07);
  }

  .feature-badge-icon {
    width: 22px;
    height: 22px;
    color: #1a4a50;
    stroke: #1a4a50;
  }

  /* ── Text ── */
  .feature-badge-content {
    flex: 1;
    min-width: 0;
  }

  .feature-badge-title {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.25;
    color: #111111;
    margin: 0 0 3px;
    font-family: var(--primary-font, sans-serif);
    white-space: nowrap;
  }

  .feature-badge-description {
    font-size: 13px;
    line-height: 1.45;
    color: rgba(0, 0, 0, 0.48);
    margin: 0;
    font-family: var(--primary-font, sans-serif);
  }

  /* ── Tablet ── */
  @media (min-width: 600px) and (max-width: 1023px) {
    .feature-badges-container {
      padding: 0 28px;
    }
    .feature-badges-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }
    .feature-badge-item {
      padding: 20px 20px;
      border-right: 1px solid rgba(14, 92, 102, 0.13);
      border-bottom: 1px solid rgba(14, 92, 102, 0.13);
    }
    /* Remove right border on even items (2-col layout) */
    .feature-badge-item:nth-child(2n) {
      border-right: none;
    }
    /* Remove bottom border on last row */
    .feature-badge-item:nth-last-child(-n+2) {
      border-bottom: none;
    }
    .feature-badge-item:first-child,
    .feature-badge-item:last-child {
      padding-left: 20px;
      padding-right: 20px;
    }
    .feature-badge-title {
      white-space: normal;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 599px) {
    .feature-badges-container {
      padding: 0 16px;
    }
    .feature-badges-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }
    .feature-badge-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 16px 14px;
      border-right: 1px solid rgba(14, 92, 102, 0.13);
      border-bottom: 1px solid rgba(14, 92, 102, 0.13);
    }
    .feature-badge-item:nth-child(2n) {
      border-right: none;
    }
    .feature-badge-item:nth-last-child(-n+2) {
      border-bottom: none;
    }
    .feature-badge-item:first-child,
    .feature-badge-item:last-child {
      padding-left: 14px;
      padding-right: 14px;
    }
    .feature-badge-icon-wrapper {
      width: 42px;
      height: 42px;
    }
    .feature-badge-icon {
      width: 18px;
      height: 18px;
    }
    .feature-badge-title {
      font-size: 13px;
      white-space: normal;
    }
    .feature-badge-description {
      font-size: 11.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-badge-icon-wrapper { transition: none; }
  }

  /* ── Section-level overrides from schema settings ── */
  #feature-badges-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }
</style>

<div
  id="feature-badges-{{ section.id }}"
  class="feature-badges-wrapper{% if section.settings.show_borders %} has-borders{% endif %}"
>
  <div class="feature-badges-container">
    <div
      class="feature-badges-grid"
      style="--badge-count: {{ section.blocks.size }};"
    >
      {% for block in section.blocks %}
        <div class="feature-badge-item" {{ block.shopify_attributes }}>

          <div class="feature-badge-icon-wrapper">
            {% case block.settings.icon %}

              {% when 'award' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="6"/>
                  <path d="M8.21 13.89L7 23L12 20L17 23L15.79 13.88"/>
                </svg>

              {% when 'leaf' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 22c1.25-1.25 2.5-2.5 3.5-4 1.5-2.4 2-5.5 2-7.5C7.5 5 11 2 16 2c2.5 0 5 .5 6 1.5C21 9 19 13.5 16 16c-2 1.5-5 2-7 2-1.5 0-3-.5-4-1L2 22z"/>
                  <line x1="12" y1="12" x2="2" y2="22"/>
                </svg>

              {% when 'shield-check' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>

              {% when 'headset' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 18v-6a9 9 0 0118 0v6"/>
                  <path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3v5z"/>
                  <path d="M3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3v5z"/>
                </svg>

              {% when 'shipping' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 3H1V16H16V3Z"/>
                  <path d="M16 8H20L23 11V16H16V8Z"/>
                  <circle cx="5.5" cy="18.5" r="2.5"/>
                  <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>

              {% when 'print' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9V2H18V9"/>
                  <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
                  <rect x="6" y="14" width="12" height="8"/>
                </svg>

              {% when 'star' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                </svg>

              {% when 'gift' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 12V22H4V12"/>
                  <path d="M22 7H2V12H22V7Z"/>
                  <path d="M12 22V7"/>
                  <path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/>
                  <path d="M12 7H16.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/>
                </svg>

              {% when 'check' %}
                <svg class="feature-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
                  <path d="M22 4L12 14.01L9 11.01"/>
                </svg>

            {% endcase %}
          </div>

          <div class="feature-badge-content">
            {% if block.settings.title != blank %}
              <h3 class="feature-badge-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="feature-badge-description">{{ block.settings.description }}</p>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Badges",
  "tag": "section",
  "class": "section-feature-badges",
  "settings": [
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show Top & Bottom Borders",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Feature Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "award",       "label": "Award / Ribbon" },
            { "value": "leaf",        "label": "Leaf / Eco" },
            { "value": "shield-check","label": "Shield Check" },
            { "value": "headset",     "label": "Headset / Support" },
            { "value": "shipping",    "label": "Shipping Truck" },
            { "value": "print",       "label": "Print on Demand" },
            { "value": "star",        "label": "Star" },
            { "value": "gift",        "label": "Gift" },
            { "value": "check",       "label": "Check Mark" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "award",        "title": "Unique Designs",       "description": "Created to make you smile" } },
        { "type": "badge", "settings": { "icon": "leaf",         "title": "Sustainable Printing", "description": "Eco-friendly inks & processes" } },
        { "type": "badge", "settings": { "icon": "shield-check", "title": "Secure Checkout",      "description": "Safe & secure payments" } },
        { "type": "badge", "settings": { "icon": "headset",      "title": "Customer Support",     "description": "We're here to help" } }
      ]
    }
  ]
}
{% endschema %}