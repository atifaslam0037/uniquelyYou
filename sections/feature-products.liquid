{% comment %}
  Featured Products Section - Optimized with Native Theme Components
  Uses product-list structure with add-to-cart-button component
  Supports Grid and Carousel layouts
{% endcomment %}

{% liquid
  assign max_items = section.settings.max_products
  assign collection = section.settings.collection
%}

<style>
  /* ── Section heading ── */
  .featured-products__heading {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground);
    font-family: var(--font-body--family, sans-serif);
  }

  /* ── Card shell ── */
  .fpc-native {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    font-family: var(--font-body--family, sans-serif);
  }

  /* ── Media wrapper ── */
  .fpc-native__media {
    position: relative;
    overflow: hidden;
    background: var(--color-background-alt, #f2f2f2);
    margin-bottom: 12px;
    border-radius: var(--style-border-radius-card, 8px);
    flex-shrink: 0;
  }

  .fpc-ar--portrait {
    aspect-ratio: 3 / 4;
  }
  .fpc-ar--square {
    aspect-ratio: 1 / 1;
  }
  .fpc-ar--landscape {
    aspect-ratio: 4 / 3;
  }
  .fpc-ar--adapt {
    aspect-ratio: auto;
    min-height: 200px;
  }

  /* ── Sale badge ── */
  .fpc-native__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 50;
    background: var(--color-badge-sale-background, var(--primary-accent, #0e5c66));
    color: var(--color-badge-sale-foreground, #fff);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    pointer-events: none;
    line-height: 1.4;
  }

  /* ── Image link fills entire media div ── */
  .fpc-native__img-link {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
    text-decoration: none;
  }

  /* ── CRITICAL FIX: both images position:absolute so real product images
     (which have explicit width/height attrs from image_tag) are sized by
     the container's aspect-ratio, NOT their intrinsic dimensions. ── */
  .fpc-native__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fpc-native__img--primary {
    z-index: 1;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fpc-native__img--secondary {
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* ── Onboarding placeholder ── */
  .fpc-native__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt, #f2f2f2);
  }

  .fpc-native__placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.12;
  }

  /* ── Hover: image swap + quick-add reveal ── */
  .fpc-native:hover .fpc-native__img--secondary,
  .fpc-native:focus-within .fpc-native__img--secondary {
    opacity: 1;
  }

  .fpc-native:hover .fpc-native__img--primary,
  .fpc-native:focus-within .fpc-native__img--primary {
    transform: scale(1.04);
  }

  /* Mirror theme product-card:hover .quick-add__button rule */
  .fpc-native:hover .quick-add__button,
  .fpc-native:focus-within .quick-add__button {
    opacity: 1;
  }

  /* Reveal choose-link on hover */
  .fpc-native:hover .fpc-native__choose-link,
  .fpc-native:focus-within .fpc-native__choose-link {
    opacity: 1;
  }

  /* ── Multi-variant "Choose Options" link button ──
     Positioned + styled to match .quick-add__button exactly */
  .fpc-native__choose-link {
    position: absolute;
    z-index: var(--layer-raised, 10);
    right: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    background: linear-gradient(var(--color-background, #fff) 0 100%) padding-box;
    padding: 0;
    border-radius: 50px;
    border: 2px solid hsl(0 0% 0% / 0.15);
    height: var(--button-size-md, 40px);
    cursor: pointer;
    opacity: 0;
    overflow: hidden;
    color: var(--color-foreground);
    text-decoration: none;
    backdrop-filter: blur(20px) saturate(180%);
    transition: opacity var(--animation-speed, 0.2s) ease, scale var(--animation-speed, 0.2s) ease;
  }

  .fpc-native__choose-link:hover {
    scale: 1.03;
  }

  .fpc-native__choose-link .add-to-cart-text {
    background: var(--color-background, #fff);
    overflow: hidden;
    border-radius: 50px;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .fpc-native__choose-link .add-to-cart-icon {
    height: 100%;
    width: calc(var(--button-size-md, 40px) - 4px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Product info ── */
  .fpc-native__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .fpc-native__vendor {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--secondary-accent, #e8612c);
  }

  .fpc-native__title {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    margin: 0;
    color: var(--color-foreground);
  }

  .fpc-native__title a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .fpc-native__title a:hover {
    color: var(--secondary-accent, #e8612c);
  }

  .fpc-native__price {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground);
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  .fpc-native__price--compare {
    text-decoration: line-through;
    opacity: 0.5;
    font-weight: 400;
    font-size: 13px;
  }

  .fpc-native__price--sale {
    color: var(--secondary-accent, #e8612c);
  }

  .fpc-native__swatches {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .fpc-native__swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--color-background, #fff);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .fpc-native__swatch:hover {
    transform: scale(1.15);
  }

  .fpc-native__swatch-more {
    font-size: 11px;
    opacity: 0.6;
    color: var(--color-foreground);
  }

  @media (max-width: 749px) {
    .fpc-native__media {
      margin-bottom: 8px;
      border-radius: 6px;
    }
    .fpc-native__title {
      font-size: 13px;
    }
    .fpc-native__price {
      font-size: 13px;
    }
    .fpc-native__choose-link {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fpc-native__img--primary,
    .fpc-native__img--secondary,
    .fpc-native__choose-link,
    .fpc-native__swatch {
      transition: none;
    }
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="featured-products"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {% comment %} Header {% endcomment %}
  <div class="section-resource-list__header">
    <div class="layout-panel-flex" style="justify-content: space-between; align-items: flex-end; width: 100%;">
      {% if section.settings.heading != blank %}
        <h2 class="featured-products__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.show_view_all and collection != blank %}
        <a href="{{ collection.url }}" class="button button--link">
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      {% endif %}
    </div>
  </div>

  {% comment %} Product List {% endcomment %}
  {% capture list_items %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: max_items %}
        <div class="resource-list__item">
          {% render 'featured-product-card-native',
            product: product,
            layout_type: section.settings.layout_type,
            show_vendor: section.settings.show_vendor,
            show_quick_add: section.settings.show_quick_add,
            image_ratio: section.settings.image_ratio
          %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% else %}
      {% comment %} Placeholder products {% endcomment %}
      {% for i in (1..max_items) %}
        <div class="resource-list__item">
          {% render 'featured-product-card-native',
            product: blank,
            layout_type: section.settings.layout_type,
            show_vendor: section.settings.show_vendor,
            show_quick_add: section.settings.show_quick_add,
            image_ratio: section.settings.image_ratio
          %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'featured-products-list'
  %}
</div>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section-featured-products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Enable quick add button",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "For grid and carousel layouts"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Enable carousel on mobile",
      "default": false,
      "info": "Only applies when layout is Grid"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "1:1"
        },
        {
          "value": "portrait",
          "label": "2:3"
        },
        {
          "value": "landscape",
          "label": "3:2"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap between products",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Carousel Settings",
      "info": "Only applies when layout is Carousel"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Navigation arrows",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "arrows_large",
          "label": "Large arrows"
        },
        {
          "value": "chevron_large",
          "label": "Large chevrons"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Arrow background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "circle"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "Mobile card size",
      "options": [
        {
          "value": "60cqw",
          "label": "Large"
        },
        {
          "value": "44cqw",
          "label": "Medium"
        }
      ],
      "default": "60cqw"
    },
    {
      "type": "header",
      "content": "Section Design"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Content gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "heading": "Featured Products",
        "max_products": 8,
        "layout_type": "grid",
        "columns": 4,
        "mobile_columns": "2",
        "show_vendor": false,
        "show_view_all": true,
        "show_quick_add": true,
        "image_ratio": "portrait",
        "columns_gap": 16,
        "rows_gap": 24,
        "carousel_on_mobile": false,
        "icons_style": "arrow",
        "icons_shape": "circle",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 60,
        "padding-block-end": 60
      }
    }
  ]
}
{% endschema %}
