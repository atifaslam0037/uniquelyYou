{% comment %}
  Featured Products Section - Optimized with Native Theme Components
  Uses product-list structure with add-to-cart-button component
  Supports Grid and Carousel layouts
{% endcomment %}

{% liquid
  assign max_items = section.settings.max_products
  assign collection = section.settings.collection
%}

<style>
  /* ── Section header + space before product grid ── */
  [data-testid='featured-products'].section-resource-list {
    row-gap: clamp(10px, 1.2vw, 16px);
  }

  [data-testid='featured-products'] .section-resource-list__header {
    margin-bottom: var(--fpc-heading-below-gap, 16px);
    padding-bottom: 0;
  }

  /*
    Section `spacing-style` sets --padding-block-* on the section root; those variables
    inherit into `.product-grid__card` (theme base.css), which wrongly padded each card.
    Reset on featured cards only — section padding stays on the outer .spacing-style div.
  */
  [data-testid='featured-products'] product-card .product-card__content.product-grid__card {
    --padding-block-start: 0px;
    --padding-block-end: 0px;
    --padding-inline-start: 0px;
    --padding-inline-end: 0px;
    padding-block: 0;
    padding-inline: 0;
  }

  [data-testid='featured-products'] .section-resource-list__header .button--link {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid #0a0a0a;
    background: #0a0a0a;
    color: #fff;
    transition: background-color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }

  [data-testid='featured-products'] .section-resource-list__header .button--link:hover {
    background: #1a1a1a;
    border-color: #1a1a1a;
    color: #fff;
  }

  .featured-products__heading {
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
    font-family: var(--font-body--family, sans-serif);
  }

  /* ── Card shell (native <product-card> + featured layout) ── */
  product-card.fpc-native {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    font-family: var(--font-body--family, sans-serif);
    border-radius: calc(var(--style-border-radius-card, 10px) + 2px);
    transition: transform 0.35s var(--ease-out-cubic, cubic-bezier(0.4, 0, 0.2, 1)),
     
  }

  product-card.fpc-native:hover,
  product-card.fpc-native:focus-within {
    transform: translateY(-3px);
  
  }



  product-card.fpc-native .product-card__content.fpc-native__stack {
    flex: 1;
    min-height: 0;
  }

  /* ── Media wrapper (vars used by theme .quick-add__button corner math) ── */
  .fpc-native__media {
    position: relative;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-background-alt, #f2f2f2) 88%, var(--color-foreground) 12%);
    margin-bottom: 12px;
    border-radius: var(--style-border-radius-card, 10px);
    flex-shrink: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 7%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-foreground) 5%, transparent);
    transition: box-shadow 0.35s var(--ease-out-cubic, cubic-bezier(0.4, 0, 0.2, 1));
    --border-radius: var(--style-border-radius-card, 10px);
    --padding-inline-end: 0px;
    --padding-block-end: 0px;
  }

  .fpc-ar--portrait {
    aspect-ratio: 3 / 4;
  }
  .fpc-ar--square {
    aspect-ratio: 1 / 1;
  }
  .fpc-ar--landscape {
    aspect-ratio: 4 / 3;
  }
  .fpc-ar--adapt {
    aspect-ratio: auto;
    min-height: 200px;
  }

  /* ── Sale badge ── */
  .fpc-native__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 50;
    background: var(--color-badge-sale-background, var(--primary-accent, #0e5c66));
    color: var(--color-badge-sale-foreground, #fff);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    pointer-events: none;
    line-height: 1.4;
  }

  /* ── Image link fills entire media div ── */
  .fpc-native__img-link {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
    text-decoration: none;
  }

  /* ── CRITICAL FIX: both images position:absolute so real product images
     (which have explicit width/height attrs from image_tag) are sized by
     the container's aspect-ratio, NOT their intrinsic dimensions. ── */
  .fpc-native__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fpc-native__img--primary {
    z-index: 1;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fpc-native__img--secondary {
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* ── Onboarding placeholder ── */
  .fpc-native__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt, #f2f2f2);
  }

  .fpc-native__placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.12;
  }

  /* ── Hover: image swap + quick-add reveal ── */
  .fpc-native:hover .fpc-native__img--secondary,
  .fpc-native:focus-within .fpc-native__img--secondary {
    opacity: 1;
  }

  .fpc-native:hover .fpc-native__img--primary,
  .fpc-native:focus-within .fpc-native__img--primary {
    transform: scale(1.04);
  }

  /* Theme rule targets `product-card`; keep reveal + cascade over bundled quick-add */
  [data-testid='featured-products'] product-card.fpc-native:hover .quick-add__button,
  [data-testid='featured-products'] product-card.fpc-native:focus-within .quick-add__button {
    opacity: 1 !important;
  }

  /* Same pill control as collection: tighter inset (theme math uses --quick-add-offset + padding) */
  [data-testid='featured-products'] .fpc-native__media .quick-add {
    --quick-add-offset: 10px;
  }

  @media screen and (min-width: 750px) {
    [data-testid='featured-products'] .fpc-native__media .quick-add {
      --quick-add-offset: 12px;
    }
  }

  [data-testid='featured-products'] .fpc-native__media .quick-add__button {
    right: 12px;
    bottom: 12px;
    transition-property: scale, translate, opacity;
    transition-duration: var(--animation-speed, 0.2s);
    transition-timing-function: var(--ease-out-cubic, cubic-bezier(0.4, 0, 0.2, 1));
  }

  /* ── Product info ── */
  .fpc-native__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    padding-top: 2px;
  }

  .fpc-native__vendor {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--secondary-accent, #e8612c);
  }

  .fpc-native__title {
    font-size: clamp(0.9rem, 1.05vw, 1.02rem);
    font-weight: 600;
    line-height: 1.28;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }

  .fpc-native__title a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .fpc-native__title a:hover {
    color: var(--secondary-accent, #e8612c);
  }

  .fpc-native__price {
    font-size: 0.875rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-foreground) 92%, transparent);
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  .fpc-native__price--compare {
    text-decoration: line-through;
    opacity: 0.5;
    font-weight: 400;
    font-size: 13px;
  }

  .fpc-native__price--sale {
    color: var(--secondary-accent, #e8612c);
  }

  .fpc-native__swatches {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .fpc-native__swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--color-background, #fff);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .fpc-native__swatch:hover {
    transform: scale(1.15);
  }

  .fpc-native__swatch-more {
    font-size: 11px;
    opacity: 0.6;
    color: var(--color-foreground);
  }

  @media (max-width: 749px) {
    .fpc-native__media {
      margin-bottom: 8px;
      border-radius: 8px;
    }
    .fpc-native__title {
      font-size: 0.875rem;
    }
    .fpc-native__price {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fpc-native__img--primary,
    .fpc-native__img--secondary,
    .fpc-native__swatch {
      transition: none;
    }

    product-card.fpc-native,
    product-card.fpc-native:hover,
    product-card.fpc-native:focus-within {
      transform: none;
      box-shadow: none;
    }

    [data-testid='featured-products'] product-card.fpc-native .quick-add__button {
      opacity: 1 !important;
    }
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="featured-products"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
    --fpc-heading-below-gap: {{ section.settings.heading_bottom_gap }}px;
  "
>
  {% comment %} Header {% endcomment %}
  <div class="section-resource-list__header">
    <div class="layout-panel-flex" style="justify-content: space-between; align-items: flex-end; width: 100%;">
      {% if section.settings.heading != blank %}
        <h2 class="featured-products__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.show_view_all and collection != blank %}
        <a href="{{ collection.url }}" class="button button--link">
          {{ 'actions.view_all' | t }}
        </a>
      {% endif %}
    </div>
  </div>

  {% comment %} Product List {% endcomment %}
  {% capture list_items %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: max_items %}
        <div class="resource-list__item">
          {% render 'featured-product-card-native',
            product: product,
            layout_type: section.settings.layout_type,
            show_vendor: section.settings.show_vendor,
            show_quick_add: section.settings.show_quick_add,
            image_ratio: section.settings.image_ratio,
            card_index: forloop.index0
          %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% else %}
      {% comment %} Placeholder products {% endcomment %}
      {% for i in (1..max_items) %}
        <div class="resource-list__item">
          {% render 'featured-product-card-native',
            product: blank,
            layout_type: section.settings.layout_type,
            show_vendor: section.settings.show_vendor,
            show_quick_add: section.settings.show_quick_add,
            image_ratio: section.settings.image_ratio,
            card_index: forloop.index0
          %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'featured-products-list'
  %}
</div>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section-featured-products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Enable quick add button",
      "default": true,
      "info": "Uses the same Add / Choose control as collection cards. Turn on Quick add (and Mobile quick add if needed) in Theme settings."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "For grid and carousel layouts"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Enable carousel on mobile",
      "default": false,
      "info": "Only applies when layout is Grid"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "1:1"
        },
        {
          "value": "portrait",
          "label": "2:3"
        },
        {
          "value": "landscape",
          "label": "3:2"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap between products",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Carousel Settings",
      "info": "Only applies when layout is Carousel"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Navigation arrows",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "arrows_large",
          "label": "Large arrows"
        },
        {
          "value": "chevron_large",
          "label": "Large chevrons"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Arrow background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "circle"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "Mobile card size",
      "options": [
        {
          "value": "60cqw",
          "label": "Large"
        },
        {
          "value": "44cqw",
          "label": "Medium"
        }
      ],
      "default": "60cqw"
    },
    {
      "type": "header",
      "content": "Section Design"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Content gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Section padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60,
      "info": "Outer section only. Does not add padding inside product cards."
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Section padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60,
      "info": "Outer section only. Does not add padding inside product cards."
    },
    {
      "type": "range",
      "id": "heading_bottom_gap",
      "label": "Space below heading",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16,
      "info": "Gap between the heading row and the product grid."
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "heading": "Featured Products",
        "max_products": 8,
        "layout_type": "grid",
        "columns": 4,
        "mobile_columns": "2",
        "show_vendor": false,
        "show_view_all": true,
        "show_quick_add": true,
        "image_ratio": "portrait",
        "columns_gap": 16,
        "rows_gap": 24,
        "carousel_on_mobile": false,
        "icons_style": "arrow",
        "icons_shape": "circle",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 60,
        "padding-block-end": 60,
        "heading_bottom_gap": 16
      }
    }
  ]
}
{% endschema %}
