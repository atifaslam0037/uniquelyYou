{% comment %}
  About Process Section
  Left: teal card with badge, heading, description, button + watermark
  Right: 4 step blocks with icon, title, description
{% endcomment %}

<style>
  /* ================================================================
     ABOUT PROCESS SECTION
  ================================================================ */

  #about-process-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_bg }};
    font-family: var(--primary-font, sans-serif);
  }

  #about-process-{{ section.id }} .ap__container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ── Two-column layout ── */
  #about-process-{{ section.id }} .ap__grid {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 0;
    align-items: stretch;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 24px rgba(0, 0, 0, 0.07);
  }

  /* ================================================================
     LEFT PANEL — teal card
  ================================================================ */

  #about-process-{{ section.id }} .ap__left {
    position: relative;
    background-color: {{ section.settings.left_bg }};
    padding: 56px 48px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    min-height: 420px;
  }

  /* Watermark illustration — faint t-shirt + leaves SVG */
  #about-process-{{ section.id }} .ap__watermark {
    position: absolute;
    bottom: -20px;
    right: -30px;
    width: 260px;
    height: 260px;
    opacity: 0.08;
    pointer-events: none;
    color: #ffffff;
  }

  #about-process-{{ section.id }} .ap__watermark svg {
    width: 100%;
    height: 100%;
  }

  /* Badge */
  #about-process-{{ section.id }} .ap__badge {
    display: block;
    font-family: var(--primary-font, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.badge_color }};
    margin-bottom: 16px;
    line-height: 1;
    position: relative;
    z-index: 1;
  }

  /* Heading */
  #about-process-{{ section.id }} .ap__heading {
    font-family: var(--primary-font, sans-serif);
    font-size: clamp(28px, 3vw, {{ section.settings.heading_size }}px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 20px;
    position: relative;
    z-index: 1;
  }

  /* Description */
  #about-process-{{ section.id }} .ap__desc {
    font-family: var(--primary-font, sans-serif);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 32px;
    position: relative;
    z-index: 1;
    max-width: 300px;
  }

  /* Button */
  #about-process-{{ section.id }} .ap__btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 30px;
    font-family: var(--primary-font, sans-serif);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    border: none;
    cursor: pointer;
    line-height: 1;
    position: relative;
    z-index: 1;
    width: fit-content;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #about-process-{{ section.id }} .ap__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
  }

  /* ================================================================
     RIGHT PANEL — steps list
  ================================================================ */

  #about-process-{{ section.id }} .ap__right {
    background-color: {{ section.settings.right_bg }};
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Single step item */
  #about-process-{{ section.id }} .ap__step {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 28px 40px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
  }

  #about-process-{{ section.id }} .ap__step:last-child {
    border-bottom: none;
  }

  /* Icon wrapper — small teal square with rounded corners */
  #about-process-{{ section.id }} .ap__step-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: {{ section.settings.icon_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  #about-process-{{ section.id }} .ap__step-icon svg {
    width: 20px;
    height: 20px;
    color: {{ section.settings.icon_color }};
    stroke: {{ section.settings.icon_color }};
  }

  /* Step text */
  #about-process-{{ section.id }} .ap__step-body {
    flex: 1;
    min-width: 0;
  }

  #about-process-{{ section.id }} .ap__step-title {
    font-family: var(--primary-font, sans-serif);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: {{ section.settings.step_title_color }};
    margin: 0 0 6px;
  }

  #about-process-{{ section.id }} .ap__step-desc {
    font-family: var(--primary-font, sans-serif);
    font-size: 13.5px;
    line-height: 1.65;
    color: {{ section.settings.step_text_color }};
    margin: 0;
  }

  /* ── Tablet ── */
  @media screen and (max-width: 1023px) {
    #about-process-{{ section.id }} .ap__container {
      padding: 0 24px;
    }

    #about-process-{{ section.id }} .ap__grid {
      grid-template-columns: 340px 1fr;
    }

    #about-process-{{ section.id }} .ap__left {
      padding: 44px 36px;
    }

    #about-process-{{ section.id }} .ap__step {
      padding: 24px 28px;
      gap: 16px;
    }
  }

  /* ── Mobile: stack vertically ── */
  @media screen and (max-width: 749px) {
    #about-process-{{ section.id }} .ap__container {
      padding: 0 16px;
    }

    #about-process-{{ section.id }} .ap__grid {
      grid-template-columns: 1fr;
      border-radius: {{ section.settings.card_radius }}px;
    }

    #about-process-{{ section.id }} .ap__left {
      min-height: 300px;
      padding: 40px 28px;
      justify-content: flex-end;
    }

    #about-process-{{ section.id }} .ap__desc {
      max-width: 100%;
    }

    #about-process-{{ section.id }} .ap__step {
      padding: 20px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #about-process-{{ section.id }} .ap__btn { transition: none; }
  }
</style>

<div id="about-process-{{ section.id }}">
  <div class="ap__container">
    <div class="ap__grid">

      {%- comment -%} LEFT — teal card {%- endcomment -%}
      <div class="ap__left">

        {%- comment -%} Watermark: t-shirt + sparkle + leaves {%- endcomment -%}
        <div class="ap__watermark" aria-hidden="true">
          <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {%- comment -%} T-shirt shape {%- endcomment -%}
            <path d="M60 30 L30 55 L50 65 L50 150 L150 150 L150 65 L170 55 L140 30 Q120 45 100 45 Q80 45 60 30Z"/>
            {%- comment -%} Hanger hook inside shirt {%- endcomment -%}
            <path d="M100 28 Q100 18 110 18 Q118 18 118 26 Q118 32 110 34 L60 60"/>
            {%- comment -%} Sparkle top-right {%- endcomment -%}
            <path d="M155 35 L157 41 L163 43 L157 45 L155 51 L153 45 L147 43 L153 41Z"/>
            {%- comment -%} Leaf bottom-left {%- endcomment -%}
            <path d="M38 130 Q28 115 35 100 Q50 108 45 125 L38 130Z"/>
            <path d="M38 130 L35 120"/>
            {%- comment -%} Small leaf right {%- endcomment -%}
            <path d="M162 130 Q172 118 168 105 Q154 112 158 127 L162 130Z"/>
            <path d="M162 130 L165 120"/>
          </svg>
        </div>

        {%- if section.settings.badge_text != blank -%}
          <span class="ap__badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="ap__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="ap__desc">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '#' }}" class="ap__btn">
            {{- section.settings.btn_label -}}
          </a>
        {%- endif -%}

      </div>

      {%- comment -%} RIGHT — steps {%- endcomment -%}
      <div class="ap__right">
        {%- for block in section.blocks -%}
          <div class="ap__step" {{ block.shopify_attributes }}>

            <div class="ap__step-icon">
              {%- case block.settings.icon -%}

                {%- when 'lightbulb' -%}
                  {%- comment -%} Step 1: Inspired Ideas — lightbulb {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="9" y1="18" x2="15" y2="18"/>
                    <line x1="10" y1="22" x2="14" y2="22"/>
                    <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>
                  </svg>

                {%- when 'printer' -%}
                  {%- comment -%} Step 2: Premium Printing — printer {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 6 2 18 2 18 9"/>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                    <rect x="6" y="14" width="12" height="8"/>
                  </svg>

                {%- when 'box' -%}
                  {%- comment -%} Step 3: Made to Order — open box {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="21 8 21 21 3 21 3 8"/>
                    <rect x="1" y="3" width="22" height="5"/>
                    <line x1="10" y1="12" x2="14" y2="12"/>
                  </svg>

                {%- when 'truck' -%}
                  {%- comment -%} Step 4: Delivered to You — delivery truck {%- endcomment -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>

                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>

                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>

                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                  </svg>

                {%- when 'palette' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="13.5" cy="6.5" r="0.5" fill="currentColor"/>
                    <circle cx="17.5" cy="10.5" r="0.5" fill="currentColor"/>
                    <circle cx="8.5" cy="7.5" r="0.5" fill="currentColor"/>
                    <circle cx="6.5" cy="12.5" r="0.5" fill="currentColor"/>
                    <path d="M12 2C6.5 2 2 6.5 2 12a10 10 0 0 0 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
                  </svg>

              {%- endcase -%}
            </div>

            <div class="ap__step-body">
              {%- if block.settings.title != blank -%}
                <h3 class="ap__step-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="ap__step-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>

          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Process",
  "tag": "section",
  "class": "section-about-process",
  "settings": [
    {
      "type": "header",
      "content": "Left Panel"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Our Process"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#E8612C"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful from start to finish."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 40
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every design is created with intention and printed on demand to reduce waste and ensure quality."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#E8612C"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "left_bg",
      "label": "Left Panel Background",
      "default": "#0E5C66"
    },
    {
      "type": "header",
      "content": "Right Panel"
    },
    {
      "type": "color",
      "id": "right_bg",
      "label": "Right Panel Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon Background",
      "default": "#E8F4F5"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#0E5C66"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step Title Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "step_text_color",
      "label": "Step Description Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 16
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#F9F5F2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lightbulb", "label": "Lightbulb (Inspired Ideas)" },
            { "value": "printer",   "label": "Printer (Premium Printing)" },
            { "value": "box",       "label": "Box (Made to Order)" },
            { "value": "truck",     "label": "Truck (Delivered to You)" },
            { "value": "palette",   "label": "Palette (Design)" },
            { "value": "star",      "label": "Star" },
            { "value": "check",     "label": "Check" },
            { "value": "heart",     "label": "Heart" }
          ],
          "default": "lightbulb"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "A short description of this step in the process."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "lightbulb",
            "title": "1. Inspired Ideas",
            "description": "We create original designs that speak to everyday moments, feelings, and fun."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "printer",
            "title": "2. Premium Printing",
            "description": "We print on high-quality apparel using eco-friendly inks that look great and last."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "box",
            "title": "3. Made to Order",
            "description": "Each item is made just for you—no overproduction, no waste."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "truck",
            "title": "4. Delivered to You",
            "description": "Fast, reliable shipping gets your new favorite piece right to your door."
          }
        }
      ]
    }
  ]
}
{% endschema %}