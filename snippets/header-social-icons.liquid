{%- doc -%}
  Header social icon links (Facebook, Instagram, TikTok, Pinterest).

  @param {object} section - Section with social URL settings
  @param {boolean} [in_sidebar] - Render inside shop sidebar footer (mobile)
{%- enddoc -%}

{% unless section.settings.show_social == false %}
  <div class="uly-header-social{% if in_sidebar %} uly-header-social--in-sidebar{% endif %}">
    {% if section.settings.social_facebook != blank %}
      <a
        href="{{ section.settings.social_facebook }}"
        class="uly-header-social__link uly-header-social__link--facebook"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
        </svg>
      </a>
    {% endif %}
    {% if section.settings.social_instagram != blank %}
      <a
        href="{{ section.settings.social_instagram }}"
        class="uly-header-social__link uly-header-social__link--instagram"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
        </svg>
      </a>
    {% endif %}
    {% if section.settings.social_tiktok != blank %}
      <a
        href="{{ section.settings.social_tiktok }}"
        class="uly-header-social__link uly-header-social__link--tiktok"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="TikTok"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.79 1.54V6.79a4.85 4.85 0 01-1.02-.1z"/>
        </svg>
      </a>
    {% endif %}
    {% if section.settings.social_pinterest != blank %}
      <a
        href="{{ section.settings.social_pinterest }}"
        class="uly-header-social__link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Pinterest"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 4.12 2.51 7.65 6.08 9.17-.08-.74-.02-1.63.19-2.44l1.34-5.68s-.34-.68-.34-1.69c0-1.58.92-2.76 2.06-2.76.97 0 1.44.73 1.44 1.6 0 .97-.62 2.42-.94 3.76-.27 1.13.57 2.05 1.69 2.05 2.03 0 3.59-2.14 3.59-5.23 0-2.73-1.96-4.64-4.76-4.64-3.24 0-5.14 2.43-5.14 4.96 0 .97.37 2.01.84 2.57a.34.34 0 01.08.32l-.3 1.22c-.05.2-.16.25-.37.15-1.38-.64-2.24-2.66-2.24-4.28 0-3.49 2.53-6.7 7.3-6.7 3.83 0 6.81 2.73 6.81 6.38 0 3.81-2.4 6.87-5.74 6.87-1.12 0-2.17-.58-2.53-1.27l-.69 2.63c-.25.97-.93 2.18-1.39 2.92 1.05.32 2.16.5 3.31.5 5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
        </svg>
      </a>
    {% endif %}
  </div>
{% endunless %}

{% stylesheet %}
  .uly-header-social {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    order: 2;
  }

  .uly-header-social__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--color-foreground);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .uly-header-social__link:hover {
    opacity: 0.75;
    transform: translateY(-1px);
  }

  .uly-header-social__link svg {
    width: 18px;
    height: 18px;
  }

  .uly-header-social__link--facebook {
    color: #1877f2;
  }

  .uly-header-social__link--instagram {
    color: #e4405f;
  }

  .uly-header-social__link--tiktok {
    color: var(--color-foreground);
  }

  @media screen and (max-width: 749px) {
    .uly-header-social:not(.uly-header-social--in-sidebar) {
      display: none;
    }
  }
{% endstylesheet %}
