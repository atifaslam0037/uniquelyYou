{%- doc -%}
  Renders social links for the custom header.

  @param {object} section - The section object.
{%- enddoc -%}

{%- liquid
  assign social_links = 'facebook,instagram,tiktok,pinterest,youtube,twitter' | split: ','
-%}

{%- if section.settings.show_social -%}
  <nav class="uly-header-social" aria-label="Social media">
    {%- for social in social_links -%}
      {%- assign setting_id = 'social_' | append: social -%}
      {%- assign social_url = section.settings[setting_id] -%}
      {%- if social_url != blank -%}
        <a
          class="uly-header-social__link"
          href="{{ social_url }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ social | capitalize }}"
        >
          <span class="svg-wrapper">
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              aria-hidden="true"
              focusable="false"
            >
              {% render 'icon', icon: social %}
            </svg>
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
{%- endif -%}
