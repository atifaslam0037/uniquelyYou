{%- doc -%}
  Renders the custom Shop All sidebar menu.

  @param {object} section - The section object.
  @param {linklist} linklist - Menu used for sidebar navigation.
  @param {string} shop_label - Label for the main Shop All link.
{%- enddoc -%}

{%- liquid
  assign drawer_label = shop_label | default: 'Shop All'
  assign collections_url = section.settings.shop_all_collections_url | default: routes.collections_url

-%}

<aside
  id="uly-shop-sidebar"
  class="uly-shop-sidebar color-{{ section.settings.color_scheme }}{% if request.page_type == 'index' %} uly-shop-sidebar--home{% else %} uly-shop-sidebar--other{% endif %}"
  aria-label="{{ drawer_label | escape }}"
  aria-hidden="true"
  hidden
>
  <div class="uly-shop-sidebar__panel">
    <div class="uly-shop-sidebar__header">
      <button
        type="button"
        class="uly-shop-sidebar__close"
        data-uly-shop-sidebar-close
        aria-label="{{ 'actions.close' | t | default: 'Close' }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>

    {%- if linklist != blank and linklist.links.size > 0 -%}
      <ul class="uly-shop-sidebar__list list-unstyled" role="list">
        {%- for link in linklist.links -%}
          <li class="uly-shop-sidebar__item">
            {%- if link.links.size > 0 -%}
              {%- assign submenu_id = 'uly-shop-submenu-' | append: section.id | append: '-' | append: forloop.index -%}
              <div class="uly-shop-sidebar__parent-row">
                <a class="uly-shop-sidebar__link" href="{{ link.url }}">{{ link.title | escape }}</a>
                <button
                  type="button"
                  class="uly-shop-sidebar__submenu-toggle"
                  data-uly-submenu-toggle
                  aria-expanded="false"
                  aria-controls="{{ submenu_id }}"
                  aria-label="Show {{ link.title | escape }} links"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="uly-shop-sidebar__arrow size-6"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </button>
              </div>

              <ul id="{{ submenu_id }}" class="uly-shop-sidebar__submenu list-unstyled" role="list" hidden>
                {%- for child_link in link.links -%}
                  <li class="uly-shop-sidebar__subitem">
                    {%- if child_link.links.size > 0 -%}
                      {%- assign child_submenu_id = submenu_id | append: '-' | append: forloop.index -%}
                      <div class="uly-shop-sidebar__parent-row uly-shop-sidebar__parent-row--child">
                        <a class="uly-shop-sidebar__sublink" href="{{ child_link.url }}">
                          {{ child_link.title | escape }}
                        </a>
                        <button
                          type="button"
                          class="uly-shop-sidebar__submenu-toggle"
                          data-uly-submenu-toggle
                          aria-expanded="false"
                          aria-controls="{{ child_submenu_id }}"
                          aria-label="Show {{ child_link.title | escape }} links"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="uly-shop-sidebar__arrow size-6"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                          </svg>
                        </button>
                      </div>

                      <ul id="{{ child_submenu_id }}" class="uly-shop-sidebar__children list-unstyled" role="list" hidden>
                        {%- for grandchild_link in child_link.links -%}
                          <li class="uly-shop-sidebar__childitem">
                            <a class="uly-shop-sidebar__childlink" href="{{ grandchild_link.url }}">
                              {{ grandchild_link.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <a class="uly-shop-sidebar__sublink" href="{{ child_link.url }}">
                        {{ child_link.title | escape }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <a class="uly-shop-sidebar__link" href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="uly-shop-sidebar__empty">
        <a class="uly-shop-sidebar__link" href="{{ collections_url }}">{{ drawer_label | escape }}</a>
      </div>
    {%- endif -%}

    <div class="uly-shop-sidebar__mobile-actions">
      {% render 'header-social-icons', section: section %}
    </div>
  </div>
</aside>
