{%- doc -%}
  Header search control that opens the theme predictive search modal.

  @param {object} section - Header section settings
{%- enddoc -%}

{% unless section.settings.show_search == false %}
  {% liquid
    assign placeholder = section.settings.search_placeholder | default: 'Find what makes you unique!'
    assign show_placeholder = section.settings.show_search_placeholder
  %}

  <search-button class="uly-header-search{% if show_placeholder %} uly-header-search--with-label{% endif %}">
    <button
      type="button"
      class="uly-header-search__trigger button-unstyled header-actions__action"
      aria-label="{{ placeholder | escape }}"
      aria-haspopup="dialog"
      on:click="#search-modal/showDialog"
    >
      <span class="svg-wrapper uly-header-search__icon" aria-hidden="true">
        {{- 'icon-search.svg' | inline_asset_content -}}
      </span>
      {% if show_placeholder %}
        <span class="uly-header-search__placeholder">{{ placeholder | escape }}</span>
      {% endif %}
    </button>
  </search-button>
{% endunless %}

{% stylesheet %}
  .uly-header-search {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .uly-header-search {
    order: 1;
  }

  .uly-header-search__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .uly-header-search--with-label .uly-header-search__trigger {
    width: auto;
    min-width: 40px;
    max-width: min(280px, 36vw);
    height: 40px;
    padding: 0 1rem 0 0.65rem;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    border-radius: var(--style-border-radius-inputs, 4px);
    background: transparent;
    justify-content: flex-start;
  }

  @media screen and (min-width: 1181px) {
    .uly-header-search--with-label .uly-header-search__trigger {
      background: var(--uly-search-trigger-background-color, var(--color-background));
    }
  }

  .uly-header-search__trigger:hover {
    color: var(--primary-accent, #0e5c66);
  }

  .uly-header-search--with-label .uly-header-search__trigger:hover {
    border-color: var(--primary-accent, var(--color-foreground));
  }

  .uly-header-search__icon {
    display: flex;
    flex-shrink: 0;
    width: 22.5px;
    height: 22.5px;
  }

  .uly-header-search__icon svg {
    width: 100%;
    height: 100%;
  }

  .uly-header-search__placeholder {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--primary-font, var(--font-body--family));
    font-size: 0.875rem;
    color: rgba(var(--color-foreground-rgb), 0.55);
    text-align: left;
  }

  @media screen and (max-width: 749px) {
    .uly-header-search--with-label .uly-header-search__trigger {
      max-width: 140px;
      padding: 0 0.5rem;
      background: transparent;
    }

    .uly-header-search--with-label .uly-header-search__placeholder {
      display: none;
    }
  }
{% endstylesheet %}
