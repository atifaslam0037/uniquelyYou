{% comment %}
  Featured Product Card — Horizon Native Quick-Add
  · Single variant  → quick-add snippet (Add to Cart, works natively)
  · Multi variant   → styled <a> link to product page (no empty modal)
  · CSS lives in feature-products.liquid <style> block for admin/live parity
{% endcomment %}

{% liquid
  assign onboarding = false
  if product == blank or product.id == empty
    assign onboarding = true
  endif

  unless onboarding
    assign variant = product.selected_or_first_available_variant
    assign has_compare_price = false
    if variant.compare_at_price > variant.price
      assign has_compare_price = true
    endif
    assign featured_media = product.featured_media
    assign second_media = product.media[1]
    assign is_multi_variant = false
    if product.variants_count > 1
      assign is_multi_variant = true
    endif

    assign color_option = null
    for option in product.options_with_values
      assign option_lc = option.name | downcase
      if option_lc contains 'color' or option_lc contains 'colour'
        assign color_option = option
        break
      endif
    endfor
  endunless

  case image_ratio
    when 'square'
      assign ar_class = 'fpc-ar--square'
    when 'landscape'
      assign ar_class = 'fpc-ar--landscape'
    when 'adapt'
      assign ar_class = 'fpc-ar--adapt'
    else
      assign ar_class = 'fpc-ar--portrait'
  endcase
%}

<div
  class="fpc-native{% if onboarding %} fpc-native--onboarding{% endif %}"
  data-product-id="{{ product.id }}"
>

  {%- comment -%} ── MEDIA ── {%- endcomment -%}
  <div
    class="fpc-native__media {{ ar_class }}"
    style="--quick-add-display: flex; --quick-add-mobile-display: none; --quick-add-mobile-opacity: 0;"
  >
    {%- comment -%} Sale badge — z-index:50 above layer-raised, pointer-events:none {%- endcomment -%}
    {% unless onboarding %}
      {% if has_compare_price %}
        <span class="fpc-native__badge">{{ 'content.product_badge_sale' | t }}</span>
      {% endif %}
    {% endunless %}

    {%- comment -%} Images (both absolutely positioned for consistent sizing) {%- endcomment -%}
    <a
      href="{% if onboarding %}#{% else %}{{ product.url }}{% endif %}"
      class="fpc-native__img-link"
      tabindex="-1"
      aria-hidden="true"
    >
      {% if onboarding %}
        <div class="fpc-native__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'fpc-native__placeholder-svg' }}
        </div>
      {% else %}
        {% if featured_media %}
          {{
            featured_media
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 1200px) 300px, (min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              widths: '300, 450, 600, 750, 900',
              class: 'fpc-native__img fpc-native__img--primary',
              alt: featured_media.alt | default: product.title
          }}
        {% endif %}
        {% if second_media %}
          {{
            second_media
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 1200px) 300px, (min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              widths: '300, 450, 600, 750, 900',
              class: 'fpc-native__img fpc-native__img--secondary',
              alt: second_media.alt | default: product.title
          }}
        {% endif %}
      {% endif %}
    </a>

    {%- comment -%}
      Quick-add logic:
      · Single variant → native quick-add snippet (renders add-to-cart form, works 100%)
      · Multi variant  → <a> link to product page (avoids empty modal entirely)
    {%- endcomment -%}
    {% unless onboarding %}
      {% if show_quick_add and product.available %}
        {% if is_multi_variant %}
          <a
            href="{{ product.url }}"
            class="fpc-native__choose-link"
            aria-label="{{ 'actions.choose' | t }}: {{ product.title }}"
          >
            <span class="add-to-cart-text">
              <span aria-hidden="true" class="svg-wrapper add-to-cart-icon">
                {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
              </span>
              <span class="add-to-cart-text__content is-visually-hidden-mobile">
                <span><span>{{ 'actions.choose' | t }}</span></span>
              </span>
            </span>
          </a>
        {% else %}
          {%- comment -%} Single variant: use the full native quick-add snippet {%- endcomment -%}
          {% render 'quick-add', product: product, section_id: section.id %}
        {% endif %}
      {% endif %}
    {% endunless %}
  </div>

  {%- comment -%} ── INFO ── {%- endcomment -%}
  <div class="fpc-native__info">
    {% unless onboarding %}
      {% if show_vendor and product.vendor != blank %}
        <span class="fpc-native__vendor">{{ product.vendor }}</span>
      {% endif %}
    {% endunless %}

    <h3 class="fpc-native__title">
      <a href="{% if onboarding %}#{% else %}{{ product.url }}{% endif %}">
        {% if onboarding %}
          {{ 'content.product_card_placeholder' | t }}
        {% else %}
          {{ product.title }}
        {% endif %}
      </a>
    </h3>

    <div class="fpc-native__price">
      {% if onboarding %}
        <span class="fpc-native__price--current">$99.00</span>
      {% else %}
        {% if has_compare_price %}
          <span class="fpc-native__price--compare">{{ variant.compare_at_price | money }}</span>
        {% endif %}
        <span class="fpc-native__price--current{% if has_compare_price %} fpc-native__price--sale{% endif %}">
          {{ variant.price | money }}
        </span>
      {% endif %}
    </div>

    {% unless onboarding %}
      {% if color_option and color_option.values.size > 0 %}
        <div class="fpc-native__swatches">
          {% for value in color_option.values limit: 5 %}
            <div
              class="fpc-native__swatch"
              style="background-color: {{ value | handle }};"
              title="{{ value }}"
              role="img"
              aria-label="{{ value }}"
            ></div>
          {% endfor %}
          {% if color_option.values.size > 5 %}
            <span class="fpc-native__swatch-more">+{{ color_option.values.size | minus: 5 }}</span>
          {% endif %}
        </div>
      {% endif %}
    {% endunless %}
  </div>
</div>

{% comment %} Ensure quick-add native button styles are loaded {% endcomment %}
{% render 'quick-add-styles' %}
