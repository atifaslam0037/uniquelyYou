{% comment %}
  Featured product card — same quick-add stack as `blocks/_product-card-gallery.liquid` / collection grid:
  `<product-card>` (theme JS/CSS), then `{% render 'quick-add', section_id: section.id %}`.
  @param card_index {number} - Loop index for stable placeholder link ids (pass `forloop.index0` from the section).
{% endcomment %}

{% liquid
  assign onboarding = false
  if product == blank or product.id == empty
    assign onboarding = true
  endif

  assign card_index = card_index | default: 0

  assign featured_can_quick_add = false
  unless onboarding
    if show_quick_add and product.available
      if settings.quick_add or settings.mobile_quick_add
        assign featured_can_quick_add = true
      endif
    endif
  endunless

  assign has_quick_add = false
  if featured_can_quick_add and settings.quick_add
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if featured_can_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  unless onboarding
    assign variant_to_link = product.selected_or_first_available_variant
    assign has_compare_price = false
    if variant_to_link.compare_at_price > variant_to_link.price
      assign has_compare_price = true
    endif
    assign featured_media = product.featured_media
    assign second_media = product.media[1]

    assign color_option = null
    for option in product.options_with_values
      assign option_lc = option.name | downcase
      if option_lc contains 'color' or option_lc contains 'colour'
        assign color_option = option
        break
      endif
    endfor

    assign product_card_id = 'fpc-link-' | append: section.id | append: '-' | append: product.id
  else
    assign product_card_id = 'fpc-link-' | append: section.id | append: '-onboard-' | append: card_index
  endunless

  case image_ratio
    when 'square'
      assign ar_class = 'fpc-ar--square'
    when 'landscape'
      assign ar_class = 'fpc-ar--landscape'
    when 'adapt'
      assign ar_class = 'fpc-ar--adapt'
    else
      assign ar_class = 'fpc-ar--portrait'
  endcase
%}

<product-card
  class="fpc-native product-card{% if onboarding %} fpc-native--onboarding{% endif %}{% if featured_can_quick_add %} fpc-native--has-atc{% endif %}"
  data-product-id="{% unless onboarding %}{{ product.id }}{% endunless %}"
  id="fpc-pc-{{ section.id }}-{% if onboarding %}onboard-{{ card_index }}{% else %}{{ product.id }}{% endif %}"
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ variant_to_link.url }}"
    {% else %}
      href="#"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {% if onboarding %}
        {{- 'content.product_card_placeholder' | t -}}
      {% else %}
        {{- product.title -}}
      {% endif %}
    </span>
  </a>

  <div
    class="product-card__content fpc-native__stack layout-panel-flex layout-panel-flex--column product-grid__card gap-style"
    style="
      {% render 'gap-style', value: 4, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
    "
  >
    <div class="fpc-native__media {{ ar_class }}">
      {% unless onboarding %}
        {% if has_compare_price %}
          <span class="fpc-native__badge">{{ 'content.product_badge_sale' | t }}</span>
        {% endif %}
      {% endunless %}

      <a
        href="{% if onboarding %}#{% else %}{{ product.url }}{% endif %}"
        class="fpc-native__img-link"
        tabindex="-1"
        aria-hidden="true"
      >
        {% if onboarding %}
          <div class="fpc-native__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'fpc-native__placeholder-svg' }}
          </div>
        {% else %}
          {% if featured_media %}
            {{
              featured_media
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 1200px) 300px, (min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                widths: '300, 450, 600, 750, 900',
                class: 'fpc-native__img fpc-native__img--primary',
                alt: featured_media.alt | default: product.title
            }}
          {% endif %}
          {% if second_media %}
            {{
              second_media
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 1200px) 300px, (min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                widths: '300, 450, 600, 750, 900',
                class: 'fpc-native__img fpc-native__img--secondary',
                alt: second_media.alt | default: product.title
            }}
          {% endif %}
        {% endif %}
      </a>

      {% if featured_can_quick_add %}
        {% render 'quick-add', product: product, section_id: section.id %}
      {% endif %}
    </div>

    <div class="fpc-native__info">
      {% unless onboarding %}
        {% if show_vendor and product.vendor != blank %}
          <span class="fpc-native__vendor">{{ product.vendor }}</span>
        {% endif %}
      {% endunless %}

      <h3 class="fpc-native__title">
        <a href="{% if onboarding %}#{% else %}{{ product.url }}{% endif %}">
          {% if onboarding %}
            {{ 'content.product_card_placeholder' | t }}
          {% else %}
            {{ product.title }}
          {% endif %}
        </a>
      </h3>

      <div class="fpc-native__price">
        {% if onboarding %}
          <span class="fpc-native__price--current">$99.00</span>
        {% else %}
          {% if has_compare_price %}
            <span class="fpc-native__price--compare">{{ variant_to_link.compare_at_price | money }}</span>
          {% endif %}
          <span class="fpc-native__price--current{% if has_compare_price %} fpc-native__price--sale{% endif %}">
            {{ variant_to_link.price | money }}
          </span>
        {% endif %}
      </div>

      {% unless onboarding %}
        {% if color_option and color_option.values.size > 0 %}
          <div class="fpc-native__swatches">
            {% for value in color_option.values limit: 5 %}
              <div
                class="fpc-native__swatch"
                style="background-color: {{ value | handle }};"
                title="{{ value }}"
                role="img"
                aria-label="{{ value }}"
              ></div>
            {% endfor %}
            {% if color_option.values.size > 5 %}
              <span class="fpc-native__swatch-more">+{{ color_option.values.size | minus: 5 }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endunless %}
    </div>
  </div>
</product-card>

{% render 'quick-add-styles' %}
