{%- doc -%}
  Automatic compact color swatches for product cards.

  @param {object} product - Product resource
{%- enddoc -%}

{%- liquid
  assign max_swatches = 5
  assign rendered_swatches = false
-%}

{%- for product_option in product.options_with_values -%}
  {%- liquid
    assign option_name = product_option.name | downcase
    assign swatch_count = product_option.values | map: 'swatch' | compact | size
    assign is_color_option = false

    if option_name contains 'color' or option_name contains 'colour' or swatch_count > 0
      assign is_color_option = true
    endif

    if rendered_swatches or is_color_option == false
      continue
    endif

    assign rendered_swatches = true
    assign swatch_option_key = 'option' | append: product_option.position
  -%}

  <div class="uly-card-swatches" aria-label="{{ product_option.name | escape }}">
    {%- for product_option_value in product_option.values limit: max_swatches -%}
      {%- liquid
        assign variant_for_value = product_option_value.variant

        if variant_for_value == blank
          for variant in product.variants
            if variant[swatch_option_key] == product_option_value.name
              assign variant_for_value = variant
              break
            endif
          endfor
        endif

        assign swatch_background = blank
        assign swatch_image = blank

        if product_option_value.swatch.image
          assign swatch_image = product_option_value.swatch.image | image_url: width: 48
          assign swatch_background = 'url(' | append: swatch_image | append: ')'
        elsif product_option_value.swatch.color
          assign swatch_background = 'rgb(' | append: product_option_value.swatch.color.rgb | append: ')'
        else
          assign color_handle = product_option_value.name | handleize
          case color_handle
            when 'black'
              assign swatch_background = '#000000'
            when 'white'
              assign swatch_background = '#ffffff'
            when 'cream', 'ivory'
              assign swatch_background = '#fff7e6'
            when 'beige', 'sand', 'tan'
              assign swatch_background = '#d8c2a3'
            when 'brown', 'chocolate'
              assign swatch_background = '#7a4a28'
            when 'gray', 'grey'
              assign swatch_background = '#8f8f8f'
            when 'light-gray', 'light-grey', 'heather-gray', 'heather-grey'
              assign swatch_background = '#c9c9c9'
            when 'dark-gray', 'dark-grey'
              assign swatch_background = '#555555'
            when 'charcoal'
              assign swatch_background = '#333333'
            when 'red'
              assign swatch_background = '#d82c2c'
            when 'orange'
              assign swatch_background = '#e8612c'
            when 'yellow'
              assign swatch_background = '#f6d44a'
            when 'green'
              assign swatch_background = '#2f8f57'
            when 'blue'
              assign swatch_background = '#2d6cdf'
            when 'sky-blue', 'light-blue'
              assign swatch_background = '#9ec9e8'
            when 'royal-blue'
              assign swatch_background = '#2454d6'
            when 'dark-blue'
              assign swatch_background = '#183a69'
            when 'navy'
              assign swatch_background = '#14213d'
            when 'purple'
              assign swatch_background = '#7d4cc2'
            when 'pink'
              assign swatch_background = '#f5a3c7'
            when 'light-pink', 'baby-pink'
              assign swatch_background = '#f8bfd4'
            when 'hot-pink'
              assign swatch_background = '#e83e8c'
            when 'multi', 'multicolor', 'multi-color'
              assign swatch_background = 'linear-gradient(135deg, #e8612c 0 25%, #f6d44a 25% 50%, #2f8f57 50% 75%, #2d6cdf 75% 100%)'
            else
              assign swatch_background = product_option_value.name | downcase
          endcase
        endif

        assign swatch_url = product.url
        if variant_for_value.url != blank
          assign swatch_url = variant_for_value.url
        endif
      -%}

      <a
        href="{{ swatch_url }}"
        class="uly-card-swatches__item{% if forloop.first %} is-active{% endif %}"
        style="--uly-card-swatch-bg: {{ swatch_background }};"
        aria-label="{{ product.title | escape }} - {{ product_option_value.name | escape }}"
        title="{{ product_option_value.name | escape }}"
      ></a>
    {%- endfor -%}

    {%- if product_option.values.size > max_swatches -%}
      <span class="uly-card-swatches__more" aria-label="{{ product_option.values.size | minus: max_swatches }} more colors">
        +{{ product_option.values.size | minus: max_swatches }}
      </span>
    {%- endif -%}
  </div>

  {%- break -%}
{%- endfor -%}

{% stylesheet %}
  .uly-card-swatches {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
    margin-block-start: 4px;
    min-height: 14px;
  }

  .uly-card-swatches__item {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex: 0 0 12px;
    background: var(--uly-card-swatch-bg, transparent);
    background-position: center;
    background-size: cover;
    border: 1px solid rgba(0, 0, 0, 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
    transition: opacity 0.15s ease;
  }

  .uly-card-swatches__item:hover,
  .uly-card-swatches__item:focus-visible {
    opacity: 0.78;
    outline: none;
  }

  .uly-card-swatches__more {
    font-size: 0.75rem;
    line-height: 1;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }
{% endstylesheet %}
